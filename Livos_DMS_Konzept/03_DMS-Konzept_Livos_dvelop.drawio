olor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="364" width="36" height="26" as="geometry"/></mxCell><mxCell id="p20-2364" value="Geschäftspartner" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1166" y="364" width="206" height="26" as="geometry"/></mxCell><mxCell id="p20-2365" value="16" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1372" y="364" width="36" height="26" as="geometry"/></mxCell><mxCell id="p20-2366" value="WKZ" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1408" y="364" width="206" height="26" as="geometry"/></mxCell><mxCell id="p20-2367" value="Quelle: LDconnect-Leistungsbeschreibung; Beleg als Link, Belegbild optional über DUO (S-03)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1130" y="396" width="484" height="30" as="geometry"/></mxCell><mxCell id="p20-2368" value="&lt;b&gt;Nicht in der Feldliste – Konsequenzen&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Fälligkeit, Skonto:&lt;/b&gt; nicht übergeben; DATEV nutzt Zahlungsbedingungen aus dem Kreditorenstamm. Ob Belegfeld 2 für ein Fälligkeitsdatum nutzbar ist, ist offen [O] (OP-22).&lt;br&gt;• &lt;b&gt;Postensperre:&lt;/b&gt; fehlt → Zahlungsfreigabe muss &lt;b&gt;vor&lt;/b&gt; der Übergabe liegen (AE-06).&lt;br&gt;• &lt;b&gt;IBAN:&lt;/b&gt; fehlt → IBAN-Abgleich in smart invoice gegen Stamm (S-02).&lt;br&gt;• &lt;b&gt;Zahlbetrag/Kürzung:&lt;/b&gt; übergeben wird der Bruttobetrag → Verarbeitung mit Trios klären (OP-05)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#F8DAD6;strokeColor=#C0392B;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="430" width="484" height="122" as="geometry"/></mxCell><mxCell id="p20-2369" value='&lt;b&gt;Einstufige Übergabe (AE-08, Entscheidung offen)&lt;/b&gt;&lt;br&gt;LDconnect übergibt je Rechnung einmal. Das „Vorerfassungsjournal" des Zielbilds ersetzt das REB (offene, unverbuchte Rechnungen, CSV zum Monatsende). Frühe Übergabe mit Postensperre über BeSync/EXTF wäre eine Anpassung [A] (Option Phase 3).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="566" width="484" height="86" as="geometry"/></mxCell><mxCell id="p20-2370" value="&lt;b&gt;Voraussetzungen (OP-04)&lt;/b&gt;&lt;br&gt;DATEVconnect, dedizierter DATEV-Benutzer, Riecken-Datengateway beim Hoster (Pflicht bei gehostetem DATEV), Beleganzeige Drittanbieter; Zugriffsweg BeSync auf DATEVconnect (OPOS) beim Hoster klären." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="666" width="484" height="84" as="geometry"/></mxCell><mxCell id="p20-2371" value="Schnittstelle" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#17324D;strokeColor=#D9DEE2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1130" y="766" width="200" height="24" as="geometry"/></mxCell><mxCell id="p20-2372" value="Richtung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#17324D;strokeColor=#D9DEE2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1330" y="766" width="234" height="24" as="geometry"/></mxCell><mxCell id="p20-2373" value="Grad" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#17324D;strokeColor=#D9DEE2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1564" y="766" width="50" height="24" as="geometry"/></mxCell><mxCell id="p20-2374" value="S-02 Stammdaten" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="790" width="200" height="24" as="geometry"/></mxCell><mxCell id="p20-2375" value="DATEV → smart invoice, täglich" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="790" width="234" height="24" as="geometry"/></mxCell><mxCell id="p20-2376" value="K" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#D9DEE2;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1564" y="790" width="50" height="24" as="geometry"/></mxCell><mxCell id="p20-2377" value="S-01 Buchungsvorschlag + Beleglink" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="814" width="200" height="24" as="geometry"/></mxCell><mxCell id="p20-2378" value="d.velop → DATEV, je Rechnung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="814" width="234" height="24" as="geometry"/></mxCell><mxCell id="p20-2379" value="K" styl