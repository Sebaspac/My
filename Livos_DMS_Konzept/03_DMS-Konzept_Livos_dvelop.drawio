=#FFFFFF;" edge="1" parent="1" source="p08-879" target="p08-880"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08-908" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p08-880" target="p08-881"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08-909" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p08-881" target="p08-882"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08-910" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p08-882" target="p08-883"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08-911" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p08-883" target="p08-884"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08-912" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p08-884" target="p08-885"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p08-913" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p08-885" target="p08-886"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><UserObject id="p08-914" label="&lt;b&gt;Bau-Rechnung (WF-02):&lt;/b&gt; nach der Sachlichen Prüfung folgt der asynchrone BIM4You-Schritt → Seite 10" link="data:page/id,p10"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="754.0" y="385.0" width="348" height="50" as="geometry"/></mxCell></UserObject><mxCell id="p08-915" value="Rechnungseingangsbuch (REB) zeigt je Beleg den aktuellen Schritt, „seit“, Zugewiesen und Status (AE-16). Zahlstatus/Zahldatum (E-23) setzt BeSync als DMS-Eigenschaft am archivierten Beleg." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="835.0" y="201.0" width="666" height="50" as="geometry"/></mxCell><UserObject id="p08-916" label="Freigabematrix je Mandant/Kostenobjekt, Stufe 2 ab Wertgrenze über Verbindung mit Bedingung auf voucher.net_amount in Cent (Beispiel &amp;gt; 500000 = 5.000 € netto) → Seite 11" link="data:page/id,p11"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1143.0" y="472.0" width="454" height="60" as="geometry"/></mxCell></UserObject><UserObject id="p08-917" label="Eskalation je Schritt und vor Skonto-/Nettofälligkeit, Vertretung über Abwesenheit → Seite 12. Sonderfälle (Kürzung, Dublette, § 13b, § 48b …) → Seite 13" link="data:page/id,p12"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1143.0" y="298.0" width="454" height="56" as="geometry"/></mxCell></UserObject><mxCell id="p08-918" value="Legende" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontStyle=1;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="964" width="64" height="20" as="geometry"/></mxCell><mxCell id="p08-919" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="106" y="966" width="24" height="16" as="geometry"/></mxCell><mxCell id="p08-920" value="d.velop Standard [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="134" y="964" width="120" height="20" as="geometry"/></mxCell><mxCell id="p08-921" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="266" y="966" width="24" height="16" as="geometry"/></mxCell><mxCell id="p08-922" value="d.velop Konfiguration [K]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="294" y="964" width="148" height="20" as="geometry"/></mxCell><mxCell id="p08-923" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="454" y="966" width="24" height="16" as="geometry"/></mxCell><mxCell id="p08-924" value="MDIS BeSync [A]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="482" y="964" width="92" height="20" as="geometry"/></mxCell><mxCell id="p08-925" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="586" y="966" width="24" height="16" as="geometry"/></mxCell><mxCell id="p08-926" value="Umsystem / extern" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="614" y="964" width="103" height="20" as="geometry"/></mxCell><mxCell id="p08-927" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F8DAD6;strokeColor=#C0392B;dashed=1;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="729" y="966" width="24" height="16" as="geometry"/></mxCell><mxCell id="p08-928" value="offen / zu verifizieren [O]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="757" y="964" width="159" height="20" as="geometry"/></mxCell><mxCell id="p08-929" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="928" y="974" as="sourcePoint"/><mxPoint x="962" y="974" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p08-930" value="Sequenz" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="966" y="964" width="47" height="20" as="geometry"/></mxCell><mxCell id="p08-931" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1025" y="974" as="sourcePoint"/><mxPoint x="1059" y="974" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p08-932" value="Datenfluss" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1063" y="964" width="64" height="20" as="geometry"/></mxCell><mxCell id="p08-933" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;startArrow=oval;startFill=0;dashed=1;strokeColor=#5F6B73;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1139" y="974" as="sourcePoint"/><mxPoint x="1173" y="974" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p08-934" value="Nachricht / E-Mail" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1177" y="964" width="108" height="20" as="geometry"/></mxCell><mxCell id="p08-935" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1297" y="974" as="sourcePoint"/><mxPoint x="1331" y="974" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p08-936" value="Ablehnen / Zurückweisen" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="964" width="136" height="20" as="geometry"/></mxCell><mxCell id="p08-937" value="&lt;b&gt;Warum die Zahlungsfreigabe vor der DATEV-Übergabe liegt (AE-06)&lt;/b&gt;&lt;br&gt;LDconnect überträgt keine Zahlungssperre. Nach der Übergabe kann der offene Posten sofort in einen Zahlungsvorschlag laufen. Deshalb übergibt d.velop erst nach der Zahlungsfreigabe an DATEV (S-01)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="994" width="514.0" height="92" as="geometry"/></mxCell><mxCell id="p08-938" value="&lt;b&gt;Einstufige Übergabe (AE-08, Entscheidung mit Trios offen)&lt;/b&gt;&lt;br&gt;Kein Vorerfassungsjournal in DATEV. Offene und noch nicht übergebene Rechnungen zeigt das REB mit Status und CSV-Export (z. B. Monatsende). Option Phase 3: frühe Übergabe mit Postensperre über BeSync [A]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570.0" y="994" width="514.0" height="92" as="geometry"/></mxCell><mxCell id="p08-939" value="&lt;b&gt;Zahlung außerhalb von d.velop (AE-10)&lt;/b&gt;&lt;br&gt;Trios bucht und erstellt den Zahlungsvorschlag in DATEV. Unterschrift und Vier-Augen bleiben in multicash. BeSync liest die offenen Posten (DATEVconnect) und meldet „bezahlt“ an den Beleg zurück (S-06)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100.0" y="994" width="514.0" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p09" name="09 Eingang, Vorqualifikation und Klärfall (WF-04)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p09-940" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=0;fillColor=#1F6F78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1654" height="8" as="geometry"/></mxCell><mxCell id="p09-941" value="09 · Eingang, Vorqualifikation und Klärfall (WF-04)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=24;fontStyle=1;fontColor=#17324D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1274" height="40" as="geometry"/></mxCell><mxCell id="p09-942" value="Eingangskanäle (AE-22), automatische Prüfungen vor dem ersten Benutzerschritt und Behandlung der Klärfälle Mandant, Kreditor, Dublette (AE-09, AE-23)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=13;fontColor=#5F6B73;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1274" height="40" as="geometry"/></mxCell><UserObject id="p09-943" label="◀ zur Übersicht (Seite 00)" link="data:page/id,p00"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1F6F78;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1334" y="28" width="280" height="30" as="geometry"/></mxCell></UserObject><mxCell id="p09-944" value="Livos · DMS-Gesamtkonzept d.velop · 09 Eingang, Vorqualifikation und Klärfall (WF-04) · MDIS Consulting · Stand 26.09.2026 · Entwurf zur Abstimmung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1135" width="1574" height="22" as="geometry"/></mxCell><mxCell id="p09-945" value="1 · Eingangskanäle (AE-22, S-14)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#F2F4F5;strokeColor=#5F6B73;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#17324D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="116" width="300" height="830" as="geometry"/></mxCell><mxCell id="p09-946" value="&lt;b&gt;rechnung@…&lt;/b&gt; zentrale Rechnungsadresse&lt;br&gt;email import über Microsoft Graph (M365) [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="56" y="156" width="268" height="62" as="geometry"/></mxCell><mxCell id="p09-947" value="&lt;b&gt;Alias je Gesellschaft&lt;/b&gt;&lt;br&gt;rechnung+&amp;lt;MandantNr&amp;gt;@… mit eigenem Importprofil → Vorbelegung Mandant [K]&lt;br&gt;(Übernahme testen, OP-02)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="56" y="232" width="268" height="84" as="geometry"/></mxCell><mxCell id="p09-948" value="&lt;b&gt;E-Rechnung&lt;/b&gt; XRechnung 3.0 · ZUGFeRD 2.x · Factur-X über dieselben Postfächer; XML ist das Original [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="56" y="330" width="268" height="70" as="geometry"/></mxCell><mxCell id="p09-949" value="&lt;b&gt;Papier&lt;/b&gt; → zentraler Scan (R-01, i