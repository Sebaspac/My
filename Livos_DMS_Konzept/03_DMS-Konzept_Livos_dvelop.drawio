=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1270" y="564" width="344" height="96" as="geometry"/></mxCell><mxCell id="p12-1338" value="&lt;b&gt;Empfänger je Mandant [K]&lt;/b&gt;&lt;br&gt;Bearbeiterfindung per Regex auf Gruppennamen, z. B. /^SI_Eskalation_#{voucher.company.nr}$/ – eine Eskalationsgruppe je Gesellschaft bzw. Verbund." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40.0" y="674" width="383.0" height="86" as="geometry"/></mxCell><mxCell id="p12-1339" value="&lt;b&gt;Wirkung [S]&lt;/b&gt;&lt;br&gt;Eskalation benachrichtigt, sie weist nicht neu zu. REB-Schnellzugriff „An mich eskalierte Rechnungen“, Statusspalte Stufe 1/2." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="437.0" y="674" width="383.0" height="86" as="geometry"/></mxCell><mxCell id="p12-1340" value="&lt;b&gt;Kanal [O]&lt;/b&gt;&lt;br&gt;Ob die Eskalation zusätzlich per E-Mail zugestellt wird, ist nicht dokumentiert → Test im Test-Tenant (OP-10)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="834.0" y="674" width="383.0" height="86" as="geometry"/></mxCell><mxCell id="p12-1341" value="&lt;b&gt;Grenzen [S]&lt;/b&gt;&lt;br&gt;Arbeitstage zählen das Wochenende nicht, Feiertage schon. Globale 2. Stufe gilt für alle Schritte; unterschiedliche Fristen je Gesellschaft nicht vorgesehen." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1231.0" y="674" width="383.0" height="86" as="geometry"/></mxCell><mxCell id="p12-1342" value="B · Vertretung (AE-17, M-18)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="778" width="1200" height="26" as="geometry"/></mxCell><mxCell id="p12-1343" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#EAF5DC;strokeColor=#8DC63F;strokeWidth=2;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55.0" y="849.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p12-1344" value="Abwesenheit" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;align=center;fontSize=9;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="30.0" y="880.0" width="80" height="16" as="geometry"/></mxCell><mxCell id="p12-1345" value="geplant: Mitarbeiter setzt Abwesenheit, Zeitraum und Vertretung im Profil [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="814" width="250" height="44" as="geometry"/></mxCell><mxCell id="p12-1346" value="ungeplant: Admin/Vorgesetzte (R-12) setzt Abwesenheit für erkrankte Kollegen [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="120" y="870" width="250" height="44" as="geometry"/></mxCell><mxCell id="p12-1347" value="neue persönliche Aufgaben gehen an die Vertretung; REB „Rechnungen in Vertretung“ [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="836" width="220" height="56" as="geometry"/></mxCell><mxCell id="p12-1348" value="offene Aufgaben gesammelt weiterleiten (berechtigte Personen) [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="690" y="836" width="220" height="56" as="geometry"/></mxCell><mxCell id="p12-1349" value="Vertreter wird beim Öffnen Workflowbeteiligter und erhält Leserecht; Protokoll [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="960" y="836" width="220" height="56" as="geometry"/></mxCell><mxCell id="p12-1350" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#F8DAD6;strokeColor=#C0392B;strokeWidth=3;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1215.0" y="849.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="p12-1351" value="Rückkehr" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;align=center;fontSize=9;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="1190.0" y="880.0" width="80" height="16" as="geometry"/></mxCell><mxCell id="p12-1352" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12-1343" target="p12-1345"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-1353" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12-1343" target="p12-1346"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-1354" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12-1345" target="p12-1347"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-1355" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="p12-1346" target="p12-1347"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-1356" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p12-1347" target="p12-1348"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-1357" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p12-1348" target="p12-1349"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-1358" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p12-1349" target="p12-1350"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p12-1359" value="&lt;b&gt;Einschränkung smart invoice:&lt;/b&gt; Die Vertretung sieht nur persönlich zugestellte Aufgaben, keine Gruppenaufgaben. → Aufgaben möglichst an Personen oder an Gruppen mit mindestens zwei Mitgliedern; keine Ein-Personen-Gruppen [K]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#F8DAD6;strokeColor=#C0392B;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1290" y="810" width="324" height="110" as="geometry"/></mxCell><mxCell id="p12-1360" value="&lt;b&gt;Governance [K]:&lt;/b&gt; Vertretungen möglichst innerhalb derselben Gesellschaftsgruppe (DMS_GF_&amp;lt;Verbund&amp;gt;, Rechte über RS_Mandant) · Freigabe-Vertretung nur durch Personen mit mindestens gleicher Freigabestufe · keine Vertretung Prüfer ↔ Freigeber desselben Vorgangs · Vertretungshandlungen im Workflowprotokoll mit handelndem Benutzer." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="936" width="1574" height="60" as="geometry"/></mxCell><mxCell id="p12-1361" value="Legende" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontStyle=1;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1092" width="64" height="20" as="geometry"/></mxCell><mxCell id="p12-1362" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="106" y="1094" width="24" height="16" as="geometry"/></mxCell><mxCell id="p12-1363" value="d.velop Standard [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;