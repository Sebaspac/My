" value="04 Informationsmodell – Kategorien und Eigenschaften" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=24;fontStyle=1;fontColor=#17324D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1274" height="40" as="geometry"/></mxCell><mxCell id="p04-374" value="Kategorien K-01 … K-15 (Dokumentarten D, Aktenarten A) mit Pflicht-Eigenschaften; Eigenschaftenkatalog E-01 … E-32 (AE-29: eine Eigenschaft je Fachbegriff)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=13;fontColor=#5F6B73;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1274" height="40" as="geometry"/></mxCell><UserObject id="p04-375" label="◀ zur Übersicht (Seite 00)" link="data:page/id,p00"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1F6F78;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1334" y="28" width="280" height="30" as="geometry"/></mxCell></UserObject><mxCell id="p04-376" value="Livos · DMS-Gesamtkonzept d.velop · 04 Informationsmodell · MDIS Consulting · Stand 26.09.2026 · Entwurf zur Abstimmung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1135" width="1574" height="22" as="geometry"/></mxCell><mxCell id="p04-377" value="Dokumentarten (D)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=none;strokeColor=#5F6B73;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#5F6B73;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="770" height="492" as="geometry"/></mxCell><mxCell id="p04-378" value="&lt;b&gt;K-01 Eingangsrechnung&lt;/b&gt; – Rechnungen, Gutschriften, Abschlags-/Schlussrechnungen (smart-invoice-Onboarding-Kategorie) · Aufbewahrung 8 J. ab E-29 · Phase 1&lt;br&gt;&lt;br&gt;&lt;b&gt;Pflicht (DMS):&lt;/b&gt; E-01 Mandant · E-25 Eingangskanal · E-29 Aufbewahrungsbeginn (E-02, E-32 automatisch aus smart invoice)&lt;br&gt;&lt;b&gt;Fachlich in smart invoice:&lt;/b&gt; E-05 Kreditor-Nr · E-08 Rechnungsnr. · E-09 Rechnungsdatum · E-10 Leistungsdatum · E-11 Beträge · E-14 Belegart · E-15 Fälligkeit/Skonto · E-16 IBAN · E-17 Kontierung · E-20 § 13b&lt;br&gt;&lt;b&gt;Bedingt:&lt;/b&gt; E-03 Objekt-ID (objektbezogen) · E-12/E-13 Zahlbetrag/Kürzungsgrund · E-18/E-19/E-21/E-22 (Bau) · E-26 Rückweisungsgrund · E-30 Verwaltungsart (WF-03)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="142" width="740" height="120" as="geometry"/></mxCell><mxCell id="p04-379" value="&lt;b&gt;K-02 Rechnungsanlage / Nachweis&lt;/b&gt;&lt;br&gt;Lieferschein, Aufmaß, Abnahmeprotokoll, Stundenzettel&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-03 · E-27&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; 8 J.&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="276" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-380" value="&lt;b&gt;K-03 Auftrag / Bestellung&lt;/b&gt;&lt;br&gt;Auftrag, Auftragsbestätigung, Bestellung&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-03 · E-19 · E-27&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; 6 J.&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="204" y="276" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-381" value="&lt;b&gt;K-04 Angebot&lt;/b&gt;&lt;br&gt;Angebote, Angebotsvergleich&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-03 · E-27&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; 6 J.&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="353" y="276" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-382" value="&lt;b&gt;K-05 Vertrag&lt;/b&gt;&lt;br&gt;Verträge, Nachträge, Kündigungen (d.velop contracts)&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-03 · E-28&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; ab Vertragsende&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 4" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="502" y="276" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-383" value="&lt;b&gt;K-06 Bescheinigung&lt;/b&gt;&lt;br&gt;FSB § 48b, Unbedenklichkeit, Versicherungsnachweise&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-05 · E-21 · E-27&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; 8 J. ab Gültigkeitsende&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 1 (Automatik 3)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="651" y="276" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-384" value="&lt;b&gt;K-07 Korrespondenz&lt;/b&gt;&lt;br&gt;Briefe, E-Mails, Rückweisungs- und Kürzungsmails, PM-Freigabemails&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-27&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; 6 J.&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 1 (Ablage auto. 2)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="55" y="440" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-385" value="&lt;b&gt;K-08 BIM4You-Prüfbericht&lt;/b&gt;&lt;br&gt;Prüfbericht, Zahlungsfreigabe, Einbehaltsnachweis&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-03 · E-05 · E-19&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; 8 J.&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 3" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="204" y="440" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-386" value="&lt;b&gt;K-09 Sonstiges Posteingangsdokument&lt;/b&gt;&lt;br&gt;Behörden, Steuer, Versicherung, Mieterpost&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-25 · E-27&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; 6 J.&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 4" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="353" y="440" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-387" value="&lt;b&gt;K-15 Organisationsunterlage&lt;/b&gt;&lt;br&gt;Verfahrensdoku, Arbeitsanweisungen, Stände Workflow/Freigabematrix, Lösch-/Rechteprotokolle&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt; E-01 · E-27 · E-29&lt;br&gt;&lt;b&gt;Aufbew.:&lt;/b&gt; 10 J.&lt;br&gt;&lt;b&gt;Phase:&lt;/b&gt; 1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFF