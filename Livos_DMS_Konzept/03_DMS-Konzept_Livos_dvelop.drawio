eight="48" as="geometry"/></mxCell><mxCell id="p11-1232" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p11-1230" target="p11-1231"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11-1233" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.904;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p11-1216" target="p11-1230"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p11-1234" value="Beträge in Bedingungen stehen in Cent (10.000,00 € = 1000000). Bezugsgröße ist netto (Standardbedingung voucher.net_amount; Livos bestätigt, AE-05). Höchste Grenze steht oben. Jede Grenze in der Abnahme mit Beträgen knapp darunter und darüber testen. Alle Grenzen: Beispiele." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="460" width="674" height="70" as="geometry"/></mxCell><mxCell id="p11-1235" value="Mandantenabhängige Grenzen: zusätzliche Verbindung mit Bedingung auf Mandant (voucher.company.nr) und Betrag vor Regel 2 – Syntax im Test-Tenant bestätigen [O]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="940" y="540" width="674" height="56" as="geometry"/></mxCell><mxCell id="p11-1236" value="Vier-Augen-Prinzip" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="612" width="674" height="26" as="geometry"/></mxCell><mxCell id="p11-1237" value="Prüfer ≠ Freigeber: Wer sachlich geprüft hat, erhält die Freigabe desselben Belegs nicht (Leistungsbeschreibung 12/2025).  &lt;b&gt;[S]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="646" width="674" height="50" as="geometry"/></mxCell><mxCell id="p11-1238" value="Zweite Freigabe ab Betrag X über Wertgrenzen-Verbindung oder Matrix-Strategie „Von unten zum Freigeber“; getrennte Gruppen je Stufe.  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="704" width="674" height="50" as="geometry"/></mxCell><mxCell id="p11-1239" value="Freigeber ≠ Zahlungsfreigeber (Vorschlag: nicht die letzte fachliche Freigabe, Test T41). „Freigabe überspringen“ wird nicht aktiviert.  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="762" width="674" height="50" as="geometry"/></mxCell><mxCell id="p11-1240" value="Vorschau-Feature „Vier-Augen-Prinzip in der Freigabe“ nur nach Freigabe durch d.velop (OP-09).  &lt;b&gt;[O]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F8DAD6;strokeColor=#C0392B;dashed=1;fontColor=#1B1B1B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="820" width="674" height="50" as="geometry"/></mxCell><mxCell id="p11-1241" value="Zahlungsausführung: Unterschrift in multicash nach Unterschriftsklassen.  &lt;b&gt;[S]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#1B1B1B;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="940" y="878" width="674" height="50" as="geometry"/></mxCell><mxCell id="p11-1242" value="Legende" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontStyle=1;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="64" height="20" as="geometry"/></mxCell><mxCell id="p11-1243" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="106" y="1092" width="24" height="16" as="geometry"/></mxCell><mxCell id="p11-1244" value="d.velop Standard [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="134" y="1090" width="120" height="20" as="geometry"/></mxCell><mxCell id="p11-1245" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="266" y="1092" width="24" height="16" as="geometry"/></mxCell><mxCell id="p11-1246" value="d.velop Konfiguration [K]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="294" y="1090" width="148" height="20" as="geometry"/></mxCell><mxCell id="p11-1247" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;" vertex="1" parent="1"><mxG