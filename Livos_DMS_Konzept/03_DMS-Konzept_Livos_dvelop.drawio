2;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="335" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3083" value="&lt;b&gt;Mandant&lt;/b&gt; (E-01): Erkennung über Name + Anschrift (AE-23) bzw. Alias. Leer/unsicher → Klärfall „Mandant unbekannt“; „Weiter“ gesperrt [S]/[K]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="332" width="338" height="47" as="geometry"/></mxCell><mxCell id="p24-3084" value="6" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="387" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3085" value="&lt;b&gt;Kreditor&lt;/b&gt;: Auswahl nur aus Kreditoren des Mandanten (DATEV-Stamm, LDconnect S-02). Fehlt → Klärfall „Kreditor fehlt“ (WF-04)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="384" width="338" height="47" as="geometry"/></mxCell><mxCell id="p24-3086" value="7" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="439" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3087" value="&lt;b&gt;Belegart&lt;/b&gt;: Abschlag/Schluss steuert Bau-Routing (WF-02) und macht Auftrags-/Vertragsnr. zur Pflicht [K]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="436" width="338" height="34" as="geometry"/></mxCell><mxCell id="p24-3088" value="8" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="478" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3089" value="&lt;b&gt;Leistungsdatum&lt;/b&gt; leer → Hinweis § 14 UStG, keine Blockade (G-4)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="475" width="338" height="34" as="geometry"/></mxCell><mxCell id="p24-3090" value="9" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="517" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3091" value="&lt;b&gt;Summenprüfung&lt;/b&gt; Netto + Steuer = Brutto, Kopf = Positionen [S]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="514" width="338" height="21" as="geometry"/></mxCell><mxCell id="p24-3092" value="10" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="544" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3093" value="&lt;b&gt;Objekt-ID&lt;/b&gt; (Custom Entity aus Lieferanten-App) – Pflicht bei objektbezogenen Kosten/Bau; trägt Aktenbildung und Bearbeiterfindung [K]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="541" width="338" height="47" as="geometry"/></mxCell><mxCell id="p24-3094" value="11" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="596" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3095" value="&lt;b&gt;Sachlicher Prüfer&lt;/b&gt;: Vorschlag der Bearbeiterfindung je Mandant/Objekt; Team oder Person [S]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="593" width="338" height="34" as="geometry"/></mxCell><mxCell id="p24-3096" value="12" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="635" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3097" value="&lt;b&gt;Positionen&lt;/b&gt;: KI-Kontierungsvorschlag und kreditorenabhängige Kontierungsvorlagen; Split über mehrere Zeilen [S]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="632" width="338" height="34" as="geometry"/></mxCell><mxCell id="p24-3098" value="13" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="674" width="20" height="20" as="geometry"/></mxCell><mxCell id="p24-3099" value="&lt;b&gt;Aktionen&lt;/b&gt;: Weiter (Standard) [S]/[K]; Klärfall → M-05; Zurückweisen → M-06 [K]/[A]; Notiz, Teilen [S]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="671" width="338" height="34" as="geometry"/></mxCell><mxCell id="p24-3100" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="1250" y="920" width="364" height="200" as="geometry"/></mxCell><mxCell id="p24-3101" value="Legende Feldarten" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="924" width="344" height="20" as="geometry"/></mxCell><mxCell id="p24-3102" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#1F6F78;strokeWidth=2;align=left;spacingLeft=6;fontSize=11;align=right;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1262" y="949" width="44" height="18" as="geometry"/></mxCell><mxCell id="p24-3103" value="Pflichtfeld (Label mit *) – je Schritt konfiguriert" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1314" y="948" width="290" height="20" as="geometry"/></mxCell><mxCell id="p24-3104" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;spacingLeft=6;fontSize=11;align=right;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1262" y="973" width="44" height="18" as="geometry"/></mxCell><mxCell id="p24-3105" value="KI-/erkannt (document reader, E-Rechnung, Vorschlag)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1314" y="972" width="290" height="20" as="geometry"/></mxCell><mxCell id="p24-3106" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#F2F4F5;strokeColor=#D9DEE2;align=left;spacingLeft=6;fontSize=11;fontColor=#5F6B73;align=right;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1262" y="997" width="44" height="18" as="geometry"/></mxCell><mxCell id="p24-3107" value="schreibgeschützt / berechnet (nur lesen)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1314" y="996" width="290" height="20" as="geometry"/></mxCell><mxCell id="p24-3108" value="▾" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D9DEE2;align=left;spacingLeft=6;fontSize=11;align=right;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1262" y="1021" width="44" height="18" as="geometry"/></mxCell><mxCell id="p24-3109" value="Auswahl (Werteliste, Stamm, Custom Entity)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1314" y="1020" width="290" height="20" as="geometry"/></mxCell><mxCell id="p24-3110" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D9DEE2;align=left;spacingLeft=6;fontSize=11;align=right;spacingRight=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1262" y="1045" width="44" height="18" as="geometry"/></mxCell><mxCell id="p24-3111" value="freie Eingabe" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1314" y="1044" width="290" height="20" as="geometry"/></mxCell><mxCell id="p24-3112" value=