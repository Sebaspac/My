="geometry"/></mxCell><mxCell id="p33-4602" value='Lieferanten-Konsolidierungsnummer aus der Lieferanten-App (LAP, über BeSync). Link „alle Gesellschaften" = gespeicherte Suche „Lieferant gesellschaftsübergreifend" (M-12).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1278" y="227" width="336" height="52" as="geometry"/></mxCell><mxCell id="p33-4603" value="3" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="288" width="20" height="20" as="geometry"/></mxCell><mxCell id="p33-4604" value="FSB gültig bis / FSB-Status als BeSync-Rückmeldung (BES), Phase 3 (AE-15)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1278" y="284" width="336" height="38" as="geometry"/></mxCell><mxCell id="p33-4605" value="4" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="331" width="20" height="20" as="geometry"/></mxCell><mxCell id="p33-4606" value="Aktenbaum links: Unterakten je Kategorie, gelb = Inhalt, grau = leer. Strukturregeln der Aktenart K-12 [K]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1278" y="327" width="336" height="38" as="geometry"/></mxCell><mxCell id="p33-4607" value="5" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="374" width="20" height="20" as="geometry"/></mxCell><mxCell id="p33-4608" value="Akteninhalt: Kategorie · Titel · Dokument-/Rechnungsdatum · Kreditor bzw. Absender · Bruttobetrag (bei K-01) · Workflowstatus (E-24) · Zahlstatus (E-23) · Status (Bearbeitung/Freigabe/Archiv)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1278" y="370" width="336" height="52" as="geometry"/></mxCell><mxCell id="p33-4609" value="6" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="431" width="20" height="20" as="geometry"/></mxCell><mxCell id="p33-4610" value='„In Akte anzeigen" zeigt alle Akten eines Dokuments – hier Kreditorenakte und Objektakte (Mehrfachablage, Test T13).' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1278" y="427" width="336" height="38" as="geometry"/></mxCell><mxCell id="p33-4611" value="7" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="474" width="20" height="20" as="geometry"/></mxCell><mxCell id="p33-4612" value="Dropzone unten in der Akte: Ablage per Drag &amp;amp; Drop automatisch, manuell oder mit Vorlage [S]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1278" y="470" width="336" height="38" as="geometry"/></mxCell><mxCell id="p33-4613" value="8" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11