ontSize=11;align=center;spacingLeft=4;spacingRight=2;verticalAlign=middle;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="70" height="30" as="geometry"/></mxCell><mxCell id="p05-638" value="K-10 Gesellschaftsakte → K-07, K-09, K-15" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;spacingRight=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110" y="1040" width="420" height="30" as="geometry"/></mxCell><mxCell id="p05-639" value="E-01" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;spacingRight=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="530" y="1040" width="250" height="30" as="geometry"/></mxCell><mxCell id="p05-640" value="E-02" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;spacingRight=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="1040" width="380" height="30" as="geometry"/></mxCell><mxCell id="p05-641" value="[K] (Ergänzung); K-15 Organisationsunterlage (10 Jahre)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F2F4F5;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;spacingRight=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="1040" width="454" height="30" as="geometry"/></mxCell><mxCell id="p05-642" value="Erkennungsfelder sind Pflicht; ohne Wert entsteht keine Verknüpfung. Rechte je Akte nach dem Muster der Seite 03 (RS_Mandant / RS_Objekt)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1072" width="1574" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p06" name="06 Lieferanten- und Kreditorenmodell"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p06-643" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=0;fillColor=#1F6F78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1654" height="8" as="geometry"/></mxCell><mxCell id="p06-644" value="06 Lieferanten- und Kreditorenmodell (AE-09)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=24;fontStyle=1;fontColor=#17324D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1274" height="40" as="geometry"/></mxCell><mxCell id="p06-645" value="Drei Nummernkreise, ein führendes System je Datenobjekt (P4). Lieferanten-App führt die Identität, DATEV führt die Kreditorenkonten." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=13;fontColor=#5F6B73;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1274" height="40" as="geometry"/></mxCell><UserObject id="p06-646" label="◀ zur Übersicht (Seite 00)" link="data:page/id,p00"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1F6F78;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1334" y="28" width="280" height="30" as="geometry"/></mxCell></UserObject><mxCell id="p06-647" value="Livos · DMS-Gesamtkonzept d.velop · 06 Lieferanten- und Kreditorenmodell · MDIS Consulting · Stand 26.09.2026 · Entwurf zur Abstimmung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1135" width="1574" height="22" as="geometry"/></mxCell><mxCell id="p06-648" value="Drei Nummernkreise" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="1060" height="26" as="geometry"/></mxCell><mxCell id="p06-649" value="① Lieferanten-Konsolidierungsnummer" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#17324D;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="146" width="344" height="40" as="geometry"/></mxCell><mxCell id="p06-650" value="&lt;b&gt;führend:&lt;/b&gt; Lieferanten-App (MDIS BeSync)&lt;br&gt;&lt;b&gt;gilt:&lt;/b&gt; gesellschaftsübergreifend – ein Lieferant = eine Nummer&lt;br&gt;&lt;b&gt;im DMS:&lt;/b&gt; Eigenschaft E-07 an der Kreditorenakte, vererbt an die Dokumente (nicht im Bucket)&lt;br&gt;&lt;b&gt;Zweck:&lt;/b&gt; Lieferantensicht über alle Gesellschaften, BI, KI-Konsolidierung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;strokeColor=#8DC63F;fillColor=#FFFFFF;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="344" height="130" as="geometry"/></mxCell><mxCell id="p06-651" value="② DATEV-Kreditorennummer je Mandant" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#17324D;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="398" y="146" width="344" height="40" as="geometry"/></mxCell><mxCell id="p06-652" value="&lt;b&gt;führend:&lt;/b&gt; DATEV (Anlage durch Trios)&lt;br&gt;&lt;b&gt;Kreis:&lt;/b&gt; 70000er, je Gesellschaft verschieden&lt;br&gt;&lt;b&gt;im DMS:&lt;/b&gt; smart-invoice-Bucket über LDconnect (S-02, täglich), Eigenschaft E-05&lt;br&gt;&lt;b&gt;Zweck:&lt;/b&gt; Buchung, Kreditorenakte (Mandant + Kreditor-Nr)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;strokeColor=#5F6B73;fillColor=#FFFFFF;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="398" y="186" width="344" height="130" as="geometry"/></mxCell><mxCell id="p06-653" value="③ HV-Kreditorennummer" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#17324D;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="756" y="146" width="344" height="40" as="geometry"/></mxCell><mxCell id="p06-654" value="&lt;b&gt;Herkunft:&lt;/b&gt; Buchhaltungen der Property Manager&lt;br&gt;&lt;b&gt;Kreis:&lt;/b&gt; 80000er&lt;br&gt;&lt;b&gt;im DMS:&lt;/b&gt; nicht im Bucket; nur Abgleich über BeSync / BI (S-16, optional Phase 3)&lt;br&gt;&lt;b&gt;Zweck:&lt;/b&gt; Vollständigkeits- und Kreditorenabgleich PM-verwalteter Objekte" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;strokeColor=#5F6B73;fillColor=#FFFFFF;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="756" y="186" width="344" height="130" as="geometry"/></mxCell><mxCell id="p06-655" value="Regeln" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="112" width="484" height="26" as="geometry"/></mxCell><mxCell id="p06-656" value="&lt;b&gt;DATEV-Stammdaten schreibt nur LDconnect&lt;/b&gt; – je Objekttyp im Bucket genau ein schreibendes System (AE-09, Kap. 8.7).&lt;br&gt;BeSync schreibt nur smart-invoice-Mandanten und Custom Entities (BIM4You) und setzt die Konsolidierungsnummer als DMS-Eigenschaft E-07 (Kreditorenakte → Dokumente).&lt;br&gt;Option B (offen): BeSync schreibt den Bucket, LDconnect nur Buchung." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;