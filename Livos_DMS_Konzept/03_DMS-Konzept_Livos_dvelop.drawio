try"/></mxCell><mxCell id="p15-1688" value="Umsystem / extern" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="614" y="828" width="103" height="20" as="geometry"/></mxCell><mxCell id="p15-1689" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F8DAD6;strokeColor=#C0392B;dashed=1;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="729" y="830" width="24" height="16" as="geometry"/></mxCell><mxCell id="p15-1690" value="offen / zu verifizieren [O]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="757" y="828" width="159" height="20" as="geometry"/></mxCell><mxCell id="p15-1691" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="928" y="838" as="sourcePoint"/><mxPoint x="962" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p15-1692" value="Sequenz" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="966" y="828" width="47" height="20" as="geometry"/></mxCell><mxCell id="p15-1693" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1025" y="838" as="sourcePoint"/><mxPoint x="1059" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p15-1694" value="Datenfluss" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1063" y="828" width="64" height="20" as="geometry"/></mxCell><mxCell id="p15-1695" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;startArrow=oval;startFill=0;dashed=1;strokeColor=#5F6B73;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1139" y="838" as="sourcePoint"/><mxPoint x="1173" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p15-1696" value="Nachricht / E-Mail" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1177" y="828" width="108" height="20" as="geometry"/></mxCell><mxCell id="p15-1697" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1297" y="838" as="sourcePoint"/><mxPoint x="1331" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p15-1698" value="Ablehnen / Zurückweisen" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="828" width="136" height="20" as="geometry"/></mxCell><mxCell id="p15-1699" value="&lt;b&gt;Warum ein eigener Prozess&lt;/b&gt;&lt;br&gt;Ca. 10 Property Manager prüfen, buchen und zahlen rund 95 % ihrer Rechnungen selbst. Nur Rechnungen über dem Schwellwert brauchen die Freigabe durch das Livos Asset Management. PM dürfen nicht zur Nutzung eines Livos-Systems verpflichtet werden – deshalb bleibt die E-Mail der Kanal. Ergebnis: zentraler Nachweis, Vertretung, Transparenz („wo hängt die Rechnung“)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="514.0" height="180" as="geometry"/></mxCell><mxCell id="p15-1700" value="&lt;b&gt;Regeln (Kapitel 11.2.3)&lt;/b&gt;&lt;br&gt;Eine Rechnung je E-Mail, Objekt und Gesellschaft im Betreff · Absenderadresse = Rückmeldeadresse · Kreditor keine Pflicht · Ablehnung nur mit Begründung · Eskalation Freigabe 3 AT an Leitung AM (Vorschlag) · REB-Schnellzugriff „PM-Freigaben offen“ · Rechnungen zählen ins invoices-Volumen · Schwellwert legt Livos fest (OP-17)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570.0" y="860" width="514.0" height="180" as="geometry"/></mxCell><mxCell id="p15-1701" value="&lt;b&gt;Rückmeldemail (Beispiel)&lt;/b&gt;&lt;br&gt;Betreff: Freigabe RE-2026-1041 · Livos Objektgesellschaft Nord mbH · 14.756,00 €&lt;br&gt;Ergebnis: Freigegeben / Abgelehnt · Begründung · Objekt · Freigeber · Datum · optional Teilen-Link auf den Beleg.&lt;br&gt;Übergang bis BeSync produktiv: manuelle Antwort bzw. „Teilen per E-Mail“ [S]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100.0" y="860" width="514.0" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p16" name="16 Vertragsprozess (WF-06)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p16-1702" value="" style="whiteSpace=wrap;htm