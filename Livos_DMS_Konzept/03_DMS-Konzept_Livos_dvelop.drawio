<mxCell id="p26-3414" value="&lt;b&gt;Register&lt;/b&gt; Historie (wer hat wann geprüft) und Belegänderungsansicht (Verteilung ↔ aktueller Schritt) [S]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="438" width="338" height="34" as="geometry"/></mxCell><mxCell id="p26-3415" value="10" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="480" width="20" height="20" as="geometry"/></mxCell><mxCell id="p26-3416" value="&lt;b&gt;Aktionen&lt;/b&gt;: Freigeben → nächste Stufe/Zahlungsfreigabe [S]; Ablehnen → zurück zur Prüfung [S]; Rückfrage mit Rückkehr in denselben Schritt [K]; Zurückweisen nur ausnahmsweise → M-06 [K]/[A]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="477" width="338" height="60" as="geometry"/></mxCell><mxCell id="p26-3417" value="11" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1250" y="545" width="20" height="20" as="geometry"/></mxCell><mxCell id="p26-3418" value="&lt;b&gt;Nur Zahlungsfreigabe (Z1)&lt;/b&gt;: IBAN (Beleg) / Bankverbindung (Stamm) mit erneuter Warnung bei Abweichung." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="1276" y="542" width="338" height="34" as="geometry"/></mxCell><mxCell id="p26-3419" value="12" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=no