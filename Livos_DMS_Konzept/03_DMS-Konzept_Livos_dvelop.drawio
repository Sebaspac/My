fontSize=11;" vertex="1" parent="1"><mxGeometry x="204" y="650" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-392" value="&lt;b&gt;K-12 Kreditorenakte&lt;/b&gt;&lt;br&gt;je Kreditor und Gesellschaft (inkl. FSB, Rahmenvertrag)&lt;br&gt;&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt;&lt;br&gt;E-01 · E-05 · E-06" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="353" y="650" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-393" value="&lt;b&gt;K-13 Vorgangsakte&lt;/b&gt;&lt;br&gt;Auftrag / Vergabeeinheit: Auftrag, Abschläge, Schlussrechnung, Nachweise&lt;br&gt;&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt;&lt;br&gt;E-01 · E-03 · E-19" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="502" y="650" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-394" value="&lt;b&gt;K-14 Vertragsakte&lt;/b&gt;&lt;br&gt;Vertrag, Nachträge, Korrespondenz (d.velop contracts)&lt;br&gt;&lt;br&gt;&lt;b&gt;Pflicht:&lt;/b&gt;&lt;br&gt;E-01 · E-28" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="651" y="650" width="142" height="156" as="geometry"/></mxCell><mxCell id="p04-395" value="&lt;b&gt;Modellregeln&lt;/b&gt;&lt;br&gt;• E-01 Mandant ist in allen Kategorien Pflicht (P1).&lt;br&gt;• Eine Eigenschaft je Fachbegriff; Demo-Struktur wird nicht übernommen (AE-29).&lt;br&gt;• Status kommt aus smart invoice (E-24) – kein eigenes Statusfeld.&lt;br&gt;• Wertemengen: Datasets aus BeSync (Mandant, Objekt); Wertelisten für Belegart, Kürzungs- und Rückweisungsgrund, Eingangskanal, § 13b (Ja/Nein).&lt;br&gt;• Aufbewahrung je Kategorie ab E-29 (AE-24)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="836" width="540" height="150" as="geometry"/></mxCell><mxCell id="p04-396" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="596" y="836" width="214" height="102" as="geometry"/></mxCell><mxCell id="p04-397" value="Legende" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="606" y="840" width="194" height="20" as="geometry"/></mxCell><mxCell id="p04-398" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="608" y="866" width="30" height="16" as="geometry"/></mxCell><mxCell id="p04-399" value="Dokumentart (D)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="646" y="864" width="154" height="20" as="geometry"/></mxCell><mxCell id="p04-400" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="608" y="890" width="30" height="16" as="geometry"/></mxCell><mxCell id="p04-401" value="Aktenart (A)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="646" y="888" width="154" height="20" as="geometry"/></mxCell><mxCell id="p04-402" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#EAF5DC;strokeColor=#D9DEE2;fontSize=10;align=left;spacingLeft=4;spacingRight=2;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="608" y="914" width="30" height="16" as="geometry"/></mxCell><mxCell id="p04-403" value="Quelle über BeSync [A]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="646" y="912" width="154" height="20" as="geometry"/></mxCell><mxCell id="p04-404" value="&lt;b&gt;Wertelisten (Vorschlag, von Livos zu bestätigen)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Rückweisungsgründe (E-26):&lt;/b&gt; (1) Pflichtangaben § 14 UStG fehlen/fehlerhaft · (2) falscher Rechnungsempfänger/Gesellschaft · (3) Leistung nicht/nicht vollständig erbracht bzw. Nachweise fehlen · (4) Preis/Menge weicht von Auftrag/Vertrag ab · (5) formaler E-Rechnungsfehler&lt;br&gt;&lt;b&gt;Kürzungsgründe (E-13):&lt;/b&gt; Mengenabweichung · Preisabweichung · Mangel/Minderung · Einbehalt · Bauabzug 15 % (§ 48) · Skonto-/Nachlassdifferenz · Sonstiges (Freitext)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="770" height="100" as="geometry"/></mxCell><mxCell id="p04-405" value="Eigenschaftenkatalog E-01 … E-32" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="838" y="112" width="776" height="22" as="geometry"/></mxCell><mxCell id="p04-406" value="ID" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fi