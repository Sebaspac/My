ry"/></mxCell><mxCell id="p21-2582" value="&lt;b&gt;Einführung (Kap. 16, 19):&lt;/b&gt; Phase 1 REB-Sichten (KPI-01/02/12/16) und Protokollierung S-12 ab Pilot-Go-live · Phase 2 evidanza-Auswertungen (KPI-03, 04, 06, 09–11, 13–15) · Phase 3 nach S-06 bzw. BIM4You-Transfer (KPI-05, 07, 08, 17)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="982" width="960" height="56" as="geometry"/></mxCell><mxCell id="p21-2583" value="evidanza-Pfad (S-12, AE-16) [A]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1020" y="520" width="594" height="26" as="geometry"/></mxCell><mxCell id="p21-2584" value="smart invoice&lt;br&gt;&lt;br&gt;Export-Event je&lt;br&gt;Schrittverbindung&lt;br&gt;(from_step / to_step)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="560" width="170" height="90" as="geometry"/></mxCell><mxCell id="p21-2585" value="BeSync&lt;br&gt;Logging-Webhook&lt;br&gt;&lt;br&gt;&lt;i&gt;sofort quittieren, Queue&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1232" y="560" width="170" height="90" as="geometry"/></mxCell><mxCell id="p21-2586" value="Task-/Process-/DMS-API&lt;br&gt;&lt;i&gt;nächtliche Abfrage&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="1020" y="680" width="170" height="80" as="geometry"/></mxCell><mxCell id="p21-2587" value="MS SQL Staging&lt;br&gt;&lt;i&gt;Beleg × Schritt × Zeit × Bearbeiter&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=cylinder3;boundedLbl=1;size=10;fillColor=#F2F4F5;strokeColor=#5F6B73;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1232" y="680" width="170" height="84" as="geometry"/></mxCell><mxCell id="p21-2588" value="evidanza&lt;br&gt;&lt;i&gt;Kennzahlen, Berichte&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1444" y="680" width="170" height="80" as="geometry"/></mxCell><mxCell id="p21-2589" value="Webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;" edge="1" parent="1" source="p21-2584" target="p21-2585"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p21-2590" value="nächtlich" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;" edge="1" parent="1" source="p21-2586" target="p21-2587"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p21-2591" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;" edge="1" parent="1" source="p21-2585" target="p21-2587"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p21-2592" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;" edge="1" parent="1" source="p21-2587" target="p21-2588"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p21-2593" value='Kennzahlen werden in SQL/evidanza berechnet – eine Spalte „Liegezeit" gibt es in d.velop nicht.' style