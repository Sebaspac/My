1" parent="1"><mxGeometry x="106" y="810" width="24" height="16" as="geometry"/></mxCell><mxCell id="p10-1094" value="d.velop Standard [S]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="134" y="808" width="120" height="20" as="geometry"/></mxCell><mxCell id="p10-1095" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="266" y="810" width="24" height="16" as="geometry"/></mxCell><mxCell id="p10-1096" value="d.velop Konfiguration [K]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="294" y="808" width="148" height="20" as="geometry"/></mxCell><mxCell id="p10-1097" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="454" y="810" width="24" height="16" as="geometry"/></mxCell><mxCell id="p10-1098" value="MDIS BeSync [A]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="482" y="808" width="92" height="20" as="geometry"/></mxCell><mxCell id="p10-1099" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="586" y="810" width="24" height="16" as="geometry"/></mxCell><mxCell id="p10-1100" value="Umsystem / extern" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="614" y="808" width="103" height="20" as="geometry"/></mxCell><mxCell id="p10-1101" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F8DAD6;strokeColor=#C0392B;dashed=1;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="729" y="810" width="24" height="16" as="geometry"/></mxCell><mxCell id="p10-1102" value="offen / zu verifizieren [O]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="757" y="808" width="159" height="20" as="geometry"/></mxCell><mxCell id="p10-1103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="928" y="818" as="sourcePoint"/><mxPoint x="962" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p10-1104" value="Sequenz" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="966" y="808" width="47" height="20" as="geometry"/></mxCell><mxCell id="p10-1105" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1025" y="818" as="sourcePoint"/><mxPoint x="1059" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p10-1106" value="Datenfluss" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1063" y="808" width="64" height="20" as="geometry"/></mxCell><mxCell id="p10-1107" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;startArrow=oval;startFill=0;dashed=1;strokeColor=#5F6B73;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1139" y="818" as="sourcePoint"/><mxPoint x="1173" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p10-1108" value="Nachricht / E-Mail" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1177" y="808" width="108" height="20" as="geometry"/></mxCell><mxCell id="p10-1109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1297" y="818" as="sourcePoint"/><mxPoint x="1331" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p10-1110" value="Ablehnen / Zurückweisen" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="808" width="136" height="20" as="geometry"/></mxCell><mxCell id="p10-1111" value="&lt;b&gt;Rückweg in d.velop (S-09)&lt;/b&gt;&lt;br&gt;BeSync setzt DMS-Eigenschaften E-22 (geprüfter Betrag, Sicherheitseinbehalt, Freigabestatus BIM4You) und legt den Prüfbericht bzw. die Zahlungsfreigabe als K-08 in der Vorgangsakte ab. Ablehnung in BIM4You → successful = false mit Meldetext → Fehler-/Klärschritt." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="514.0" height="170" as="geometry"/></mxCell><mxCell id="p10-1112" value="&lt;b&gt;Zahlbetrag manuell (OP-07)&lt;/b&gt;&lt;br&gt;Ein API-Schreibzugriff auf laufende smart-invoice-Belege ist nicht dokumentiert. Die Rechnungsprüfung überträgt den BIM4You-Zahlbetrag in pay_amount mit Kürzungsgrund „Einbehalt“ bzw. „Bauabzug 15 %“. Automatische Übernahme nur nach Bestätigung durch d.velop." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570.0" y="840" width="514.0" height="170" as="geometry"/></mxCell><mxCell id="p10-1113" value="&lt;b&gt;Abgrenzung und Übergang&lt;/b&gt;&lt;br&gt;BIM4You führt Budget, Vertrag/Nachtrag, VOB-Kumulation und Einbehalte; d.velop führt Beleg, Workflow, Freigabe und DATEV-Übergabe. Storno in BIM4You wird gespiegelt. Sonderbuchungsinfos (ARAP/PARP, Rückstellungen) Folgeprojekt. Pilot-Bau in Phase 1: über WF-01 ohne BIM4You-Automatik; Prüfer trägt Zahlbetrag mit Kürzungsgrund ein. WF-02 ab Phase 3." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100.0" y="840" width="514.0" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="11 Freigabematrix und Wertgrenzen"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11-1114" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=0;fillColor=#1F6F78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1654" height="8" as="geometry"/></mxCell><mxCell id="p11-1115" value="11 · Freigabematrix und Wertgrenzen" style="whiteSpace=wrap;html=1;fontF