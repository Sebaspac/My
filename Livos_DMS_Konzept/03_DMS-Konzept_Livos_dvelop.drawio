or=#5F6B73;rounded=0;" edge="1" parent="1" source="p03-297" target="p03-301"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03-303" value="&lt;b&gt;10020&lt;/b&gt;&lt;br&gt;Livos Objektgesellschaft Süd mbH" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;fontSize=10;" vertex="1" parent="1"><mxGeometry x="187" y="460" width="128" height="66" as="geometry"/></mxCell><mxCell id="p03-304" value="" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=block;endFill=1;strokeColor=#5F6B73;rounded=0;" edge="1" parent="1" source="p03-297" target="p03-303"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03-305" value="&lt;b&gt;10030&lt;/b&gt;&lt;br&gt;Livos Bau &amp;amp; Projekt GmbH" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;fontSize=10;" vertex="1" parent="1"><mxGeometry x="324" y="460" width="128" height="66" as="geometry"/></mxCell><mxCell id="p03-306" value="" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=block;endFill=1;strokeColor=#5F6B73;rounded=0;" edge="1" parent="1" source="p03-297" target="p03-305"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03-307" value="&lt;b&gt;…&lt;/b&gt;&lt;br&gt;bis 1.000 Mandanten je Bucket" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;fontSize=10;" vertex="1" parent="1"><mxGeometry x="461" y="460" width="128" height="66" as="geometry"/></mxCell><mxCell id="p03-308" value="" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=block;endFill=1;strokeColor=#5F6B73;rounded=0;" edge="1" parent="1" source="p03-297" target="p03-307"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03-309" value="Mandanten = Gesellschaften (Beispiel-IDs, fiktive Demo-Gesellschaften)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="530" width="540" height="20" as="geometry"/></mxCell><mxCell id="p03-310" value="Segmente (E-31, aus dem Gesellschaftsstamm)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="560" height="26" as="geometry"/></mxCell><mxCell id="p03-311" value="Bestand" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="180" height="34" as="geometry"/></mxCell><mxCell id="p03-312" value="Objektgesellschaften im Bestand, z.B. Livos Objektgesellschaft Nord mbH (Beispiel)&lt;br&gt;&lt;br&gt;&lt;b&gt;Prozess:&lt;/b&gt; WF-01; PM-verwaltete Objekte zusätzlich WF-03 (PM-Freigabe)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;strokeColor=#1F6F78;fillColor=#FFFFFF;fontSize=11;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="634" width="180" height="150" as="geometry"/></mxCell><mxCell id="p03-313" value="Privatisierung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="230" y="600" width="180" height="34" as="geometry"/></mxCell><mxCell id="p03-314" value="Gesellschaften mit Verkauf von Einheiten&lt;br&gt;&lt;br&gt;&lt;b&gt;Prozess:&lt;/b&gt; WF-01; bei Verkauf einer Gesellschaft Export je Gesellschaft (S-15)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;strokeColor=#1F6F78;fillColor=#FFFFFF;fontSize=11;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="230" y="634" width="180" height="150" as="geometry"/></mxCell><mxCell id="p03-315" value="Bau" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420" y="600" width="180" height="34" as="geometry"/></mxCell><mxCell id="p03-316" value="Projekt- und Baugesellschaften, z.B. Livos Bau &amp;amp; Projekt GmbH (Beispiel)&lt;br&gt;&lt;br&gt;&lt;b&gt;Prozess:&lt;/b&gt; WF-02 mit BIM4You (S-08 / S-09); Kennzeichen Bauleistender § 13b" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;strokeColor=#1F6F78;fillColor=#FFFFFF;fontSize=11;spacingLeft=6;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="420" y="634" width="180" height="150" as="geometry"/></mxCell><mxCell id="p03-317" value="&lt;b&gt;Gesellschaftsstamm (AE-28) – führend Lieferanten-App / BeSync&lt;/b&gt;&lt;br&gt;Mandanten-ID · Name exakt wie auf Rechnungen · Anschrift · USt-IdNr. · StNr. · DATEV-Berater-/Mandantennr. · Segment · Bauleistender § 13b · Verwaltungsart Eigen-/PM-verwaltet · PM-Name · Freigabeverbund&lt;br&gt;→ per API in smart-invoice-Mandanten, DMS-Datasets und Restriction Sets (S-04)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="560" height="104" as="geometry"/></mxCell><mxCell id="p03-318" value="&lt;b&gt;Mandantenerkennung (AE-23):&lt;/b&gt; Der Standard erkennt den Empfänger über Name + Anschrift. Gleiche Anschriften (z.B. Nord und Bau &amp;amp; Projekt, Hafenstraße 22) brauchen das Maßnahmenbündel: exakte Gesellschaftsbezeichnung, Käuferreferenz (BT-10), Alias-Postfach je Gesellschaft, Klärfall-Mandant, Test mit echten Livos-Belegen (OP-02)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#F8DAD6;strokeColor=#C0392B;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="560" height="96" as="geometry"/></mxCell><mxCell id="p03-319" value="Gesellschaft = Mandant (P1, AE-03)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="112" width="470" height="26" as="geometry"/></mxCell><mxCell id="p03-320" value="&lt;b&gt;Gesellschaftsschlüssel = Mandanten-ID&lt;/b&gt;&lt;br&gt;DMS-Eigenschaft „Mandant“ (E-01) + „Mandantenname“ (E-02)&lt;br&gt;keine zweite Eigenschaft „Gesellschaft“&lt;br&gt;&lt;br&gt;&lt;b&gt;Mandanten-ID = DATEV-Mandantennummer (Vorschlag)&lt;/b&gt;&lt;br&gt;feste Länge, nur Ziffern, z.B. 10010 (Format mit Trios abstimmen)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="470" height="150" as="geometry"/></mxCell><mxCell id="p03-321" value="Der Schlüssel steuert:" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontStyle=1;fontSize=11;spacing=0;" vertex="1" parent="1"><mxGeometry x="640" y="312" width="470" height="20" as="geometry"/></mxCell><mxCell id="p03-322" value="&lt;b&gt;Rechte&lt;/b&gt;&lt;br&gt;Restriction Sets RS_Mandant_Lesen/_Bearbeiten, Gruppen DMS_G_/DMS_GB_&amp;lt;MandantNr&amp;gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="338" width="230" height="78" as="geometry"/></mxCell><mxCell id="p03-323" value="&lt;b&gt;Aktenbildung&lt;/b&gt;&lt;br&gt;Mandant in jeder Erkennung (S1–S6, Seite 05)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="338" width="230" height="78" as="geometry"/></mxCell><mxCell id="p03-324" value="&lt;b&gt;Workflow-Routing&lt;/b&gt;&lt;br&gt;Freigabematrix Spalte Mandant, Clearing je Mandant" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="426" width="230" height="78" as="geometry"/></mxCell><mxCell id="p03-325" value="&lt;b&gt;DATEV-Übergabe&lt;/b&gt;&lt;br&gt;LDconnect je DATEV-Mandant (S-01 / S-02)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="426" width="230" height="78" as="geometry"/></mxCell><mxCell id="p03-326" value="&lt;b&gt;Mandantenerkennung&lt;/b&gt;&lt;br&gt;Name + Anschrift, Alias-Postfach je Gesellschaft" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="514" width="230" height="78" as="geometry"/></mxCell><mxCell id="p03-327" value="&lt;b&gt;Export je Gesellschaft&lt;/b&gt;&lt;br&gt;Verkauf, Betriebsprüfung (S-15)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="514" width="230" height="78" as="geometry"/></mxCell><mxCell id="p03-328" value="Rechtebezug orthogonal: Rolle × Gesellschaft (AE-18)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="616" width="470" height="26" as="geometry"/></mxCell><mxCell id="p03-329" value="&lt;b&gt;DMS_R_Pruefer&lt;/b&gt;&lt;br&gt;Rollengruppe → Permission" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="640" y="654" width="220" height="60" as="geometry"/></mxCell><mxCell id="p03-330" value="&lt;b&gt;DMS_G_10010 / DMS_GB_10010&lt;/b&gt;&lt;br&gt;Gesellschaftsgruppen → RS_Mandant_Lesen / _Bearbeiten" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="890" y="654" width="220" height="60" as="geometry"/></mxCell><mxCell id="p03-331" value="Benutzer bearbeitet Belege der Kategorie K nur für Mandant 10010" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="720" y="764" width="310" height="60" as="geometry"/></mxCell><mxCell id="p03-332" value="" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=block;endFill=1;strokeColor=#5F6B73;rounded=0;" edge="1" parent="1" source="p03-329" target="p03-331"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03-333" value="" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=block;endFill=1;strokeColor=#5F6B73;rounded=0;" edge="1" parent="1" source="p03-330" target="p03-331"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03-334" value="Annahme: Das Restriction Set zieht Werte aus allen Gruppen des Benutzers (Test T03, OP-08)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="640" y="834" width="470" height="34" as="geometry"/></mxCell><mxCell id="p03-335" value="&lt;b&gt;Mengengerüst Rechte&lt;/b&gt;&lt;br&gt;• ca. 50–70 Permissions, unabhängig von der Zahl der Gesellschaften&lt;br&gt;• Rollengruppen DMS_R_* (ca. 10–12)&lt;br&gt;• Gesellschaftsgruppen DMS_G_ / DMS_GB_&amp;lt;MandantNr&amp;gt; (nur Werteträger)&lt;br&gt;• Verbundgruppen DMS_GF_&amp;lt;Verbund&amp;gt; für Geschäftsführung&lt;br&gt;• Objektgruppen DMS_O_&amp;lt;ObjektID&amp;gt; für Projektleitung (RS_Objekt)&lt;br&gt;• smart-invoice-Gruppen dv_* / SI_&amp;lt;Rolle&amp;gt;_&amp;lt;MandantNr&amp;gt;&lt;br&gt;• Identitäten aus Entra ID per SCIM, flache Gruppen (S-13)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="876" width="470" height="140" as="geometry"/></mxCell><mxCell id="p03-336" value="Limits je smart-invoice-Bucket" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="112" width="464" height="26" as="geometry"/></mxCell><mxCell id="p03-337" value="&lt;b style='font-size:18px'&gt;1.000&lt;/b&gt;&lt;br&gt;Mandanten je Bucket" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#D6ECEE;strokeColor=#1F6F78;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1150" y="148" width="148" height="72" as="geometry"/></mxCell><mxCell id="p03-338" value="&lt;b style='font-size:18px'&gt;100.000&lt;/b&gt;&lt;br&gt;Kreditoren je Bucket" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#D6ECEE;strokeColor=#1F6F78;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1308" y="148" width="148" height="72" as="geometry"/></mxCell><mxCell id="p03-339" value="&lt;b style='font-size:18px'&gt;50.000&lt;/b&gt;&lt;br&gt;Sachkonten je Bucket" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#D6ECEE;strokeColor=#1F6F78;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1466" y="148" width="148" height="72" as="geometry"/></mxCell><mxCell id="p03-340" value="&lt;b style='font-size:18px'&gt;100&lt;/b&gt;&lt;br&gt;Workflowdefinitionen je Bucket (je max. 50 Schritte)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#D6ECEE;strokeColor=#1F6F78;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1150" y="230" width="148" height="72" as="geometry"/></mxCell><mxCell id="p03-341" value="&lt;b style='font-size:18px'&gt;50&lt;/b&gt;&lt;br&gt;Buckets bzw. Repositories (max.)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#D6ECEE;strokeColor=#1F6F78;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1308" y="230" width="148" height="72" as="geometry"/></mxCell><mxCell id="p03-342" value="Quelle: smart invoice Cloud Handbuch 06/2026" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1466" y="230" width="148" height="72" as="geometry"/></mxCell><mxCell id="p03-343" value="Kreditoren werden je Mandant angelegt: Bei &amp;gt; 100 DATEV-Mandanten Kreditoren- und Sachkontenlimit beobachten." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#F8DAD6;strokeColor=#C0392B;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="314" width="464" height="58" as="geometry"/></mxCell><mxCell id="p03-344" value="Onboarding neue Gesellschaft (per API automatisierbar)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="386" width="464" height="26" as="geometry"/></mxCell><mxCell id="p03-345" value="Auslöser: Gesellschaft in der Lieferanten-App freigegeben (R-12) → BeSync (S-04)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#17324D;fontStyle=1;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="420" width="464" height="50" as="geometry"/></mxCell><mxCell id="p03-346" value="&lt;b&gt;smart-invoice-Mandant im Bucket&lt;/b&gt;&lt;br&gt;ID, Name und Anschrift exakt wie auf Rechnungen (Stammdaten-API)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="494" width="424" height="62" as="geometry"/></mxCell><mxCell id="p03-347" value="1" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;ellipse;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1150" y="511" width="28" height="28" as="geometry"/></mxCell><mxCell id="p03-348" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;exitX=0.543;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p03-345" target="p03-346"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p03-349" value="&lt;b&gt;Dataset-Wert „Mandant“ ergänzen&lt;/b&gt;&lt;br&gt;DMS-Wertemenge über DmsConfig-API" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeo