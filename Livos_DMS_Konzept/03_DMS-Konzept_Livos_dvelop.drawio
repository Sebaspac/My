1"><mxGeometry x="52.0" y="158" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1382" value="Zahlbetrag pay_amount &amp;lt; Brutto (Kopf/Position, Neuberechnung)  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="52.0" y="234" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1383" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1381" target="p13-1382"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1384" value="Pflicht: Kürzungsgrund E-13 + Notiz/Annotation  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="52.0" y="310" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1385" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1382" target="p13-1384"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1386" value="optional Kürzungsmitteilung an Lieferant (S-11)  &lt;b&gt;[A]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="52.0" y="386" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1387" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1384" target="p13-1386"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1388" value="&lt;b&gt;Original bleibt unverändert&lt;/b&gt; (P5, § 146 Abs. 4 AO; XML ist Original). Keine „lokale Bearbeitung“. Formal/steuerlich falsche Rechnung → Rückweisung. DATEV-Verarbeitung des Zahlbetrags mit Trios klären (OP-05)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="48.0" y="458" width="289.2" height="120" as="geometry"/></mxCell><mxCell id="p13-1389" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="357.2" y="112" width="305.2" height="470" as="geometry"/></mxCell><mxCell id="p13-1390" value="Rückweisung (AE-13, WF-05)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="357.2" y="112" width="305.2" height="34" as="geometry"/></mxCell><mxCell id="p13-1391" value="Aktion „An Lieferant zurückweisen“ in Verteilung/Prüfung  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="369.2" y="158" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1392" value="Pflicht-Rückweisungsgrund E-26 (Werteliste)  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="369.2" y="234" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1393" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1391" target="p13-1392"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1394" value="Export → BeSync: Vorlage je Grund an vendor.email (Graph oder d.velop-Messaging-API, OP-25)  &lt;b&gt;[A]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="369.2" y="310" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1395" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1392" target="p13-1394"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1396" value="gesendete Mail als K-07 in Kreditorenakte  &lt;b&gt;[A]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="369.2" y="386" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1397" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1394" target="p13-1396"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1398" value="&lt;b&gt;5 Gründe (Vorschlag):&lt;/b&gt; 1 Pflichtangaben § 14 · 2 falscher Empfänger · 3 Leistung/Nachweise fehlen · 4 Preis/Menge weicht ab · 5 E-Rechnungsfehler. Phase 1: „Teilen per E-Mail/Link“ manuell [S]; automatische Mail ab Phase 2." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365.2" y="458" width="289.2" height="120" as="geometry"/></mxCell><mxCell id="p13-1399" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="674.4" y="112" width="305.2" height="470" as="geometry"/></mxCell><mxCell id="p13-1400" value="Dublette" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="674.4" y="112" width="305.2" height="34" as="geometry"/></mxCell><mxCell id="p13-1401" value="Stufe 1 document reader: Rechnungsnummer  &lt;b&gt;[S]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="686.4" y="158" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1402" value="Stufe 2 smart invoice: Kreditor + Nummer, 18 Monate  &lt;b&gt;[S]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="686.4" y="234" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1403" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1401" target="p13-1402"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1404" value="R-02 vergleicht mit Original (Klärfall C, Seite 09)  &lt;b&gt;[S]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="686.4" y="310" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1405" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1402" target="p13-1404"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1406" value="echt: ablehnen ohne Mail · sonst Annahme mit Begründung  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="686.4" y="386" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1407" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1404" target="p13-1406"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1408" value="Häufig bei Doppeleingang Mail + Post oder PDF + E-Rechnung. Abgelehnte Dublette bleibt archiviert und mit dem Original verknüpft. Lieferanten: nur noch elektronisch an rechnung@." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="682.4" y="458" width="289.2" height="120" as="geometry"/></mxCell><mxCell id="p13-1409" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="991.5999999999999" y="112" width="305.2" height="470" as="geometry"/></mxCell><mxCell id="p13-1410" value="Abschlag / Schluss kumuliert" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="991.5999999999999" y="112" width="305.2" height="34" as="geometry"/></mxCell><mxCell id="p13-1411" value="Belegart Abschlag/Schluss (E-14; XRechnung 875/877)  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1003.5999999999999" y="158" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1412" value="Auftrags-Nr. E-19, Vergabeeinheit E-18 → Vorgangsakte K-13  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1003.5999999999999" y="234" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1413" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1411" target="p13-1412"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1414" value="kumulierte VOB-Prüfung in BIM4You (WF-02)  &lt;b&gt;[A]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1003.5999999999999" y="310" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1415" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1412" target="p13-1414"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1416" value="Ergebnis E-22 + Prüfbericht K-08 am Beleg  &lt;b&gt;[A]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1003.5999999999999" y="386" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1417" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1414" target="p13-1416"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1418" value="Beispiel: 60.000 € kumuliert − 25.000 € 1. Abschlag − 3.500 € Einbehalt = 31.500 €. Schlussrechnung: vereinnahmte Teilentgelte absetzen (§ 14 Abs. 5 UStG). Katalog 5.2: N (d.velop) / A (BIM4You)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="999.5999999999999" y="458" width="289.2" height="120" as="geometry"/></mxCell><mxCell id="p13-1419" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="1308.8" y="112" width="305.2" height="470" as="geometry"/></mxCell><mxCell id="p13-1420" value="Sicherheitseinbehalt" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1308.8" y="112" width="305.2" height="34" as="geometry"/></mxCell><mxCell id="p13-1421" value="BIM4You berechnet Einbehalt je Abschlag" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1320.8" y="158" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1422" value="E-22 Sicherheitseinbehalt am Beleg (S-09)  &lt;b&gt;[A]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1320.8" y="234" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1423" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1421" target="p13-1422"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1424" value="Zahlbetrag reduziert, Kürzungsgrund „Einbehalt“  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1320.8" y="310" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1425" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1422" target="p13-1424"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1426" value="Verwaltung über Laufzeit/Rückgabe in BIM4You bzw. DATEV-OP" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1320.8" y="386" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1427" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1424" target="p13-1426"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1428" value="VOB/B § 17: je Zahlung höchstens 10 % bis zur vereinbarten Sicherheitssumme. Rückgabe nach Abnahme bzw. Gewährleistung außerhalb von d.velop." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1316.8" y="458" width="289.2" height="120" as="geometry"/></mxCell><mxCell id="p13-1429" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="40.0" y="594" width="305.2" height="470" as="geometry"/></mxCell><mxCell id="p13-1430" value="Reverse Charge § 13b UStG" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40.0" y="594" width="305.2" height="34" as="geometry"/></mxCell><mxCell id="p13-1431" value="Bau-Kreditor mit Steuerkategorie (z. B. BAU13B) je Mandant  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="52.0" y="640" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1432" value="automatische Steuerschlüsselermittlung Kreditor × Sachkonto  &lt;b&gt;[S]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="52.0" y="716" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1433" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1431" target="p13-1432"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1434" value="Plausibilität: § 13b-Fall mit USt ≠ 0 → Hinweis/Klärfall  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="52.0" y="792" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1435" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1432" target="p13-1434"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1436" value="E-20 = Ja; Buchung durch Trios" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="52.0" y="868" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1437" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1434" target="p13-1436"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1438" value="Nur Gesellschaften, die selbst nachhaltig Bauleistungen erbringen, sind Steuerschuldner (Kennzeichen im Gesellschaftsstamm, AE-28). Gesellschaften und DATEV-BU-Schlüssel mit Trios/Steuerberatung klären." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="48.0" y="940" width="289.2" height="120" as="geometry"/></mxCell><mxCell id="p13-1439" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontS