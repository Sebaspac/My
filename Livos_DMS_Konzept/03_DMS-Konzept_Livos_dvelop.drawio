onalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1442" target="p13-1444"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1446" value="EIBE-Einzelabfrage beim BZSt manuell (keine API)  &lt;b&gt;[S]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="369.2" y="868" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1447" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1444" target="p13-1446"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1448" value="Bagatellgrenzen 5.000 € bzw. 15.000 € je Leistendem und Jahr. Anmeldung und Abführung in DATEV durch Trios. Bis Phase 3: E-21 „FSB-Status“ Pflichtfeld in der Verteilung [K]. Katalog 2.7 = A." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="365.2" y="940" width="289.2" height="120" as="geometry"/></mxCell><mxCell id="p13-1449" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="674.4" y="594" width="305.2" height="470" as="geometry"/></mxCell><mxCell id="p13-1450" value="Gutschrift / Storno" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="674.4" y="594" width="305.2" height="34" as="geometry"/></mxCell><mxCell id="p13-1451" value="Belegart Gutschrift bzw. Stornorechnung (E-14)  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="686.4" y="640" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1452" value="Verweis auf Ursprungsrechnung (Notiz/Custom-Feld)  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="686.4" y="716" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1453" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1451" target="p13-1452"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1454" value="Pfad in WF-01: Verteilung → Prüfung → Buchhaltung  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="686.4" y="792" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1455" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1452" target="p13-1454"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1456" value="Ursprung noch offen: mit Verweis ablehnen  &lt;b&gt;[K]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="686.4" y="868" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1457" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;labelBackgroundColor=#FFFFFF;endSize=5;" edge="1" parent="1" source="p13-1454" target="p13-1456"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p13-1458" value="Keine Zahlungsfreigabe im Gutschriftpfad. Empfehlung: Pfad in WF-01 über Bedingung auf Belegart; alternativ eigene Workflowdefinition. Die ID WF-04 bleibt dem Klärfall vorbehalten." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="682.4" y="940" width="289.2" height="120" as="geometry"/></mxCell><mxCell id="p13-1459" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="991.5999999999999" y="594" width="305.2" height="470" as="geometry"/></mxCell><mxCell id="p13-1460" value="E-Rechnung formal fehlerhaft" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="991.5999999999999" y="594" width="305.2" height="34" as="geometry"/></mxCell><mxCell id="p13-1461" value="XRechnung-Validierung KoSIT, Prüfbericht als Anlage  &lt;b&gt;[S]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1003.5999999999999" y="640" width="281.2" height="62" as="geometry"/></mxCell><mxCell id="p13-1462" value="ZUGFeRD MINIMUM/BASIC-WL erkennen  &lt;b&gt;[A]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12