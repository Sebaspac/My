t="34" as="geometry"/></mxCell><mxCell id="p18-2186" value="Admin" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#D9DEE2;fontSize=11;align=left;spacingLeft=4;verticalAlign=middle;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1356" y="646" width="258" height="34" as="geometry"/></mxCell><mxCell id="p18-2187" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="40" y="694" width="330" height="150" as="geometry"/></mxCell><mxCell id="p18-2188" value="Legende Rechtestufen" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="698" width="310" height="20" as="geometry"/></mxCell><mxCell id="p18-2189" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#D6ECEE;strokeColor=#D9DEE2;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="52" y="724" width="30" height="16" as="geometry"/></mxCell><mxCell id="p18-2190" value="L/S = Lesen + Schreiben (bearbeiten, anlegen)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="722" width="270" height="20" as="geometry"/></mxCell><mxCell id="p18-2191" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#DCEAF7;strokeColor=#D9DEE2;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="52" y="748" width="30" height="16" as="geometry"/></mxCell><mxCell id="p18-2192" value="L = Lesen" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="746" width="270" height="20" as="geometry"/></mxCell><mxCell id="p18-2193" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFF5CC;strokeColor=#D9DEE2;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="52" y="772" width="30" height="16" as="geometry"/></mxCell><mxCell id="p18-2194" value="L (W) = nur als Workflowbeteiligte/r" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="770" width="270" height="20" as="geometry"/></mxCell><mxCell id="p18-2195" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#F8DAD6;strokeColor=#D9DEE2;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="52" y="796" width="30" height="16" as="geometry"/></mxCell><mxCell id="p18-2196" value="L/S/Lö = zusätzlich Löschen (nur R-12)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="794" width="270" height="20" as="geometry"/></mxCell><mxCell id="p18-2197" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#FFFFFF;strokeColor=#D9DEE2;fontSize=11;align=center;verticalAlign=middle;fontStyle=1;fontColor=#5F6B73;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="52" y="820" width="30" height="16" as="geometry"/></mxCell><mxCell id="p18-2198" value="– = kein Zugriff im DMS" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="818" width="270" height="20" as="geometry"/></mxCell><mxCell id="p18-2199" value="&lt;b&gt;Geltungsbereich&lt;/b&gt;&lt;br&gt;&lt;b&gt;(M)&lt;/b&gt; eigene Gesellschaften über RS_Mandant_Lesen / _Bearbeiten&lt;br&gt;&lt;b&gt;(A)&lt;/b&gt; alle Gesellschaften (eigene Permission Kxx_A_Zentral ohne Filter)&lt;br&gt;&lt;b&gt;(O)&lt;/b&gt; nur freigegebene Objekte über RS_Objekt&lt;br&gt;&lt;b&gt;(W)&lt;/b&gt; nur als Workflowbeteiligter (K01_W_User / K01_W_Group)&lt;br&gt;&lt;b&gt;(T)&lt;/b&gt; temporär, gefiltert auf Gesellschaft und Prüfungszeitraum" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="384" y="694" width="400" height="150" as="geometry"/></mxCell><mxCell id="p18-2200" value="&lt;b&gt;Anmerkungen (Kap. 13.4)&lt;/b&gt;&lt;br&gt;¹ R-03: Projektleitung/Objektbetreuung mit reinem Objektbezug (O) statt (M); Schreibrecht K-02 für Nachweise, K-09 für Übernahme verteilter Post.&lt;br&gt;² R-04: GF erhält den Geltungsbereich über DMS_GF_&amp;lt;Verbund&amp;gt;.   ³ R-07: Konzern-Controlling ggf. (A) statt (M), Entscheidung Livos.&lt;br&gt;⁴ R-12: Löschen nur im Status Bearbeitung; Löschsperre (preventDeletion) übersteuert alle Löschrechte (AE-24).&lt;br&gt;⁵ R-13: Schreiben auf K-01 (E-07, E-21, E-22, E-23), K-07 (Mails), K-08 (BIM4You), K-15 (Prüfberichte); Lesen aller Kategorien für Export S-15.&lt;br&gt;⁶ R-14: nur Lesen; K-04 und K-09 nur nach Einzelfreigabe der Steuerabteilung.   ⁷ R-15: Inhaltszugriff nur befristet mit Freigabe Livos." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="798" y="694" width="816" height="150" as="geometry"/></mxCell><mxCell id="p18-2201" value="&lt;b&gt;Umsetzung in d.velop documents (AE-18)&lt;/b&gt; – je Kategorie und Rechtestufe eine Permission (read / write / delete; ALLOWED · INHERITED · DENIED, DENIED gewinnt); Muster Kxx_M_Lesen, Kxx_M_Bearbeiten, Kxx_A_Zentral, Kxx_O_…, K01_W_…, Kxx_Admin → ca. 50–70 Permissions für 15 Kategorien, unabhängig von der Zahl der Gesellschaften (Seite 19).&lt;br&gt;&lt;b&gt;Außerhalb der DMS-Matrix:&lt;/b&gt; smart-invoice-Rechte (Workflowrollen SI_&amp;lt;Rolle&amp;gt;_&amp;lt;MandantNr&amp;gt;, REB je Mandant, Clearing), d.velop contracts (VTR_&amp;lt;Organisation&amp;gt;_&amp;lt;Rolle&amp;gt;), mail dispatcher (POST_&amp;lt;Verbund&amp;gt;_&amp;lt;Funktion&amp;gt;), process studio (Modellierung R-15, Test R-12), Lieferanten-App (App-Rollen).&lt;br&gt;&lt;b&gt;Unverträglich:&lt;/b&gt; R-02 + R-05, R-06 + R-05 in einer Person; R-12 + R-05 nur mit GF-Freigabe; R-15 ohne Fachrollen. R-09/R-10 ohne DMS-Zugang; R-10 gibt nur eine Stellungnahme ab, die verbindliche Freigabe erfolgt intern (Kap. 11.5.3)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#F2F4F5;strokeColor=#D9DEE2;rounded=1;arcSize=6;verticalAlign=middle;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="858" width="1574" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p19" name="19 Rechtemodell Cloud"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p19-2202" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=0;fillColor=#1F6F78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1654" height="8" as="geometry"/></mxCell><mxCell id="p19-2203" value="19 Rechtemodell Cloud" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=24;fontStyle=1;fontColor=#17324D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1274" height="40" as="geometry"/></mxCell><mxCell id="p19-2204" value="Mechanik (Kap. 13.2/13.3): Entra ID → SCIM → flache Gruppen → Restriction Sets → Permission je Kategorie × Rechtestufe (AE-18). Gesellschaftstrennung über die Pflichteigenschaft Mandant (E-01, Designprinzip P1)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=13;fontColor=#5F6B73;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1274" height="40" as="geometry"/></mxCell><UserObject id="p19-2205" label="◀ zur Übersicht (Seite 00)" link="data:page/id,p00"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1F6F78;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1334" y="28" width="280" height="30" as="geometry"/></mxCell></UserObject><mxCell id="p19-2206" value="Livos · DMS-Gesamtkonzept d.velop · 19 Rechtemodell Cloud · MDIS Consulting · Stand 26.09.2026 · Entwurf zur Abstimmung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1135" width="1574" height="22" as="geometry"/></mxCell><mxCell id="p19-2207" value="Microsoft Entra ID&lt;br&gt;&lt;br&gt;&lt;i&gt;Benutzer und Sicherheitsgruppen&lt;/i&gt;&lt;br&gt;&lt;i&gt;führend, Pflege Livos-IT (OP-16)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="168" width="230" height="110" as="geometry"/></mxCell><mxCell id="p19-2208" value="BeSync / Lieferanten-App (S-04)&lt;br&gt;&lt;br&gt;&lt;i&gt;legt je Gesellschaft Dataset-Wert, Gruppe, Set-Zuordnung und smart-invoice-Mandant per API an; prüft Governance&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="230" height="120" as="geometry"/></mxCell><mxCell id="p19-2209" value="d.velop Gruppen (flach)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#D6ECEE;strokeColor=#1F6F78;opacity=60;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#17324D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="340" y="128" width="310" height="420" as="geometry"/></mxCell><mxCell id="p19-2210" value="DMS_R_*  Rollengruppen&lt;br&gt;&lt;i&gt;Träger der Permissions (~10–12)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="355" y="168" width="280" height="62" as="geometry"/></mxCell><mxCell id="p19-2211" value="DMS_G_ / DMS_GB_&amp;lt;MandantNr&amp;gt;  Gesellschaft&lt;br&gt;&lt;i&gt;Werteträger RS_Mandant_Lesen / _Bearbeiten&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="355" y="242" width="280" height="62" as="geometry"/></mxCell><mxCell id="p19-2212" value="DMS_GF_&amp;lt;Verbund&amp;gt;  Gesellschaftsverbund&lt;br&gt;&lt;i&gt;Werteliste eigener Gesellschaften (GF)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="355" y="316" width="280" height="62" as="geometry"/></mxCell><mxCell id="p19-2213" value="DMS_O_&amp;lt;ObjektID&amp;gt;  Objekt&lt;br&gt;&lt;i&gt;Werteträger RS_Objekt (PL, Externe)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="355" y="390" width="280" height="62" as="geometry"/></mxCell><mxCell id="p19-2214" value="dv_* / SI_&amp;lt;Rolle&amp;gt;_&amp;lt;MandantNr&amp;gt;&lt;br&gt;&lt;i&gt;smart-invoice-Workflowrollen, REB&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="355" y="464" width="280" height="62" as="geometry"/></mxCell><mxCell id="p19-2215" value="S-13 SCIM 2.0&lt;br&gt;+ SSO (OIDC)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2207" target="p19-2210"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2216" value="Gruppen anlegen&lt;br&gt;(über Entra ID)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2208" target="p19-2211"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2217" value="Restriction Sets (Gruppe → Werteliste)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#D6ECEE;strokeColor=#1F6F78;opacity=60;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#17324D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="128" width="300" height="420" as="geometry"/></mxCell><mxCell id="p19-2218" value="&lt;b&gt;RS_Mandant_Lesen&lt;/b&gt;&lt;br&gt;DMS_G_10010 → [10010]&lt;br&gt;DMS_G_10020 → [10020]&lt;br&gt;DMS_GF_Nord → [10010, 10020, 10050]&lt;br&gt;&lt;b&gt;RS_Mandant_Bearbeiten&lt;/b&gt;&lt;br&gt;DMS_GB_10010 → [10010]&lt;br&gt;&lt;i&gt;neue Gesellschaft = 1 Zuordnung&lt;/i&gt;&lt;br&gt;&lt;i&gt;(API POST …/assignments)&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="735" y="168" width="270" height="170" as="geometry"/></mxCell><mxCell id="p19-2219" value="&lt;b&gt;RS_Objekt&lt;/b&gt;&lt;br&gt;DMS_O_4711 → [4711]&lt;br&gt;&lt;i&gt;Projektleiter / Externe nur für ein Objekt&lt;/i&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="735" y="358" width="270" height="80" as="geometry"/></mxCell><mxCell id="p19-2220" value="Zwei Sets je Rechtestufe, damit jemand in Gesellschaft A bearbeiten und in B nur lesen kann (Werteliste aus allen Gruppen, T03)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="450" width="270" height="86" as="geometry"/></mxCell><mxCell id="p19-2221" value="Werte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2211" target="p19-2218"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2222" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2212" target="p19-2218"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2223" value="Werte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2213" target="p19-2219"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2224" value="Permissions: Kategorie × Rechtestufe" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#D6ECEE;strokeColor=#1F6F78;opacity=60;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#17324D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="128" width="340" height="420" as="geometry"/></mxCell><mxCell id="p19-2225" value="&lt;b&gt;K01_M_Lesen&lt;/b&gt;&lt;br&gt;Mandant = @Filter(RS_Mandant_Lesen) → DMS_R_Freigeber, DMS_R_Controlling: read" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1102" y="164" width="316" height="58" as="geometry"/></mxCell><mxCell id="p19-2226" value="&lt;b&gt;K01_M_Bearbeiten&lt;/b&gt;&lt;br&gt;Mandant = @Filter(RS_Mandant_Bearbeiten) → DMS_R_Pruefer: read + write" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1102" y="227" width="316" height="58" as="geometry"/></mxCell><mxCell id="p19-2227" value="&lt;b&gt;K01_A_Zentral&lt;/b&gt;&lt;br&gt;nur CATEGORY (ohne Filter) → DMS_R_Buchhaltung_Extern: read + write" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1102" y="290" width="316" height="58" as="geometry"/></mxCell><mxCell id="p19-2228" value="&lt;b&gt;K11_O_Lesen&lt;/b&gt;&lt;br&gt;Objekt-ID = @Filter(RS_Objekt) → Projektleitung, DMS_R_Partner_Extern: read" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1102" y="353" width="316" height="58" as="geometry"/></mxCell><mxCell id="p19-2229" value="&lt;b&gt;K01_W_User / K01_W_Group&lt;/b&gt;&lt;br&gt;WorkflowbeteiligteIDs = @CURRENT_USER / @CURRENT_USER_IN_GROUP: read" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1102" y="416" width="316" height="58" as="geometry"/></mxCell><mxCell id="p19-2230" value="&lt;b&gt;Kxx_Admin&lt;/b&gt;&lt;br&gt;→ DMS_R_Fachadmin: read/write/delete (+ Löschsperre)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1102" y="479" width="316" height="58" as="geometry"/></mxCell><mxCell id="p19-2231" value="@Filter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2218" target="p19-2225"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2232" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2218" target="p19-2226"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2233" value="@Filter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2219" target="p19-2228"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2234" value="Zuordnung read/write/delete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2210" target="p19-2225"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="619.0" y="120"/><mxPoint x="1402.2" y="120"/></Array></mxGeometry></mxCell><mxCell id="p19-2235" value="Dokument K-01&lt;br&gt;&lt;br&gt;Mandant (E-01)&lt;br&gt;Objekt-ID (E-03)&lt;br&gt;Workflow-beteiligte (E-32)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#FFFFFF;strokeColor=#5F6B73;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="168" width="144" height="150" as="geometry"/></mxCell><mxCell id="p19-2236" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2226" target="p19-2235"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2237" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2229" target="p19-2235"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2238" value="&lt;b&gt;Rechtestufen (Cloud)&lt;/b&gt;&lt;br&gt;read / write / delete getrennt&lt;br&gt;&lt;br&gt;ALLOWED · INHERITED · DENIED&lt;br&gt;&lt;br&gt;&lt;b&gt;DENIED gewinnt&lt;/b&gt; über alle Permissions einer Gruppe" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1450" y="348" width="164" height="200" as="geometry"/></mxCell><mxCell id="p19-2239" value='Beispiel: Benutzerin „Asset Managerin Nord" sieht und bearbeitet nur Mandant 10010' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=#F2F4F5;strokeColor=#5F6B73;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#17324D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="574" width="1574" height="300" as="geometry"/></mxCell><mxCell id="p19-2240" value='&lt;b&gt;„Asset Managerin Nord"&lt;/b&gt; (Beispiel)&lt;br&gt;&lt;br&gt;Mitglied in:&lt;br&gt;DMS_R_Pruefer&lt;br&gt;DMS_G_10010, DMS_GB_10010' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="240" height="110" as="geometry"/></mxCell><mxCell id="p19-2241" value="&lt;b&gt;RS_Mandant_Bearbeiten wertet alle Gruppen des Benutzers aus&lt;/b&gt;&lt;br&gt;&lt;br&gt;DMS_GB_10010 → [10010]&lt;br&gt;berechnete Werteliste = &lt;b&gt;[10010]&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="360" y="640" width="270" height="110" as="geometry"/></mxCell><mxCell id="p19-2242" value="&lt;b&gt;Permission K01_M_Bearbeiten&lt;/b&gt;&lt;br&gt;(zugeordnet an DMS_R_Pruefer)&lt;br&gt;&lt;br&gt;Prüfung: Mandant des Dokuments ∈ [10010]?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="690" y="640" width="290" height="110" as="geometry"/></mxCell><mxCell id="p19-2243" value="Mandant&lt;br&gt;in Liste?" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#FFF5CC;strokeColor=#E8912D;fontColor=#1B1B1B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="660" width="110" height="70" as="geometry"/></mxCell><mxCell id="p19-2244" value="RE-2026-1041 · Musterbau GmbH · 14.756,00 €&lt;br&gt;Mandant 10010 · Livos Objektgesellschaft Nord mbH" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#FFFFFF;strokeColor=#5F6B73;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="620" width="390" height="56" as="geometry"/></mxCell><mxCell id="p19-2245" value="Eingangsrechnung Mandant 10020 (Livos Objektgesellschaft Süd mbH)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#FFFFFF;strokeColor=#5F6B73;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="700" width="390" height="50" as="geometry"/></mxCell><mxCell id="p19-2246" value="Eingangsrechnung Mandant 10030 (Livos Bau &amp;amp; Projekt GmbH)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#FFFFFF;strokeColor=#5F6B73;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="770" width="390" height="50" as="geometry"/></mxCell><mxCell id="p19-2247" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1" source="p19-2240" target="p19-2241"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2248" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1" source="p19-2241" target="p19-2242"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2249" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1" source="p19-2242" target="p19-2243"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2250" value="ja: lesen + bearbeiten" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#8DC63F;fontColor=#17324D;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2243" target="p19-2244"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1075" y="648"/></Array></mxGeometry></mxCell><mxCell id="p19-2251" value="nein: unsichtbar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2243" target="p19-2245"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p19-2252" value="nein" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p19-2243" target="p19-2246"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1075" y="795"/></Array></mxGeometry></mxCell><mxCell id="p19-2253" value='&lt;b&gt;Ausnahme Workflowbeteiligte:&lt;/b&gt; Wird der Benutzer an einer Rechnung von Mandant 10020 beteiligt (z.B. als Vertretung), erhält er über „K01_W_User" Leserecht auf genau diese Rechnung. Deshalb Vertretungen möglichst innerhalb derselben Gesellschaftsgruppe (AE-17).&lt;br&gt;&lt;b&gt;Grenze des orthogonalen Modells:&lt;/b&gt; Rolle × Gesellschaft gilt für alle Gesellschaften des Benutzers gleich – abweichende Rechte je Gesellschaft über getrennte Sets je Rechtestufe.' style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="930" height="96" as="geometry"/></mxCell><mxCell id="p19-2254" value="&lt;b&gt;Achtung: leere Werteliste = alle Werte&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eine Restriction-Set-Zuordnung mit leerer Liste (oder Typ NO_ASSIGNMENT) gibt Zugriff auf &lt;b&gt;alle&lt;/b&gt; Mandanten.&lt;br&gt;&lt;br&gt;• Zentrale Buchhaltung/Controlling nie über leere Listen, sondern über eine eigene, sichtbare Permission ohne Mandant-Filter.&lt;br&gt;• BeSync prüft täglich: keine leeren Listen, keine NO_ASSIGNMENT-Zuordnung; Rechteänderungen mit Vier-Augen-Freigabe und Protokoll [A]." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#F8DAD6;strokeColor=#C0392B;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="420" height="200" as="geometry"/></mxCell><mxCell id="p19-2255" value="&lt;b&gt;Test T03 (OP-08) – Kernannahme vor Go-live&lt;/b&gt;&lt;br&gt;&lt;br&gt;Annahme: Die Werteliste eines Restriction Sets ergibt sich aus &lt;b&gt;allen&lt;/b&gt; Gruppen des Benutzers – Permission an der Rollengruppe, Werte nur über die Gesellschaftsgruppe.&lt;br&gt;&lt;br&gt;Test im Test-Tenant: Benutzer in DMS_R_Pruefer + DMS_G_10010 sieht nur 10010.&lt;br&gt;Falls widerlegt: kombinierte Gruppen DMS_&amp;lt;Rolle&amp;gt;_&amp;lt;MandantNr&amp;gt; (mehr Gruppen, weiterhin per API automatisierbar)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#F8DAD6;strokeColor=#C0392B;fontColor=#17324D;dashed=1;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="900" width="420" height="200" as="geometry"/></mxCell><mxCell id="p19-2256" value="&lt;b&gt;Neue Gesellschaft – 4 Schritte, per API automatisierbar (S-04)&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Dataset-Wert Mandant (E-01)&lt;br&gt;2. Entra-Gruppen DMS_G_/DMS_GB_&amp;lt;Nr&amp;gt; (SCIM)&lt;br&gt;3. Zuordnung in RS_Mandant_Lesen/_Bearbeiten&lt;br&gt;4. smart-invoice-Mandant im Bucket&lt;br&gt;&lt;br&gt;REB-Berechtigung je Mandant ggf. manuell (API nicht dokumentiert).&lt;br&gt;Mengengerüst: ca. 50–70 Permissions, unabhängig von der Gesellschaftszahl." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="920" y="900" width="380" height="200" as="geometry"/></mxCell><mxCell id="p19-2257" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="1320" y="900" width="300" height="150" as="geometry"/></mxCell><mxCell id="p19-2258" value="Legende Status" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1330" y="904" width="280" height="20" as="geometry"/></mxCell><mxCell id="p19-2259" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1332" y="930" width="30" height="16" as="geometry"/></mxCell><mxCell id="p19-2260" value="d.velop Standard" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1370" y="928" width="240" height="20" as="geometry"/></mxCell><mxCell id="p19-2261" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="1332" y="954" width="30" height="16" as="geometry"/></mxCell><mxCell id="p19-2262" value="d.velop Konfiguration" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1370" y="952" width="240" height="20" as="geometry"/></mxCell><mxCell id="p19-2263" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#EAF5DC;strokeColor=#8DC63F;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1332" y="978" width="30" height="16" as="geometry"/></mxCell><mxCell id="p19-2264" value="MDIS BeSync (Anpassung)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1370" y="976" width="240" height="20" as="geometry"/></mxCell><mxCell id="p19-2265" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#17324D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1332" y="1002" width="30" height="16" as="geometry"/></mxCell><mxCell id="p19-2266" value="Umsystem / extern" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1370" y="1000" width="240" height="20" as="geometry"/></mxCell><mxCell id="p19-2267" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#F8DAD6;strokeColor=#C0392B;fontColor=#17324D;dashed=1;" vertex="1" parent="1"><mxGeometry x="1332" y="1026" width="30" height="16" as="geometry"/></mxCell><mxCell id="p19-2268" value="offen / zu verifizieren" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x=