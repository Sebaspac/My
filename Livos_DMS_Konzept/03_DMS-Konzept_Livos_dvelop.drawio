ontSize=12;text;fontSize=12;align=center;verticalAlign=middle;fontSize=10;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="272.0" y="224" width="140" height="32" as="geometry"/></mxCell><mxCell id="p20-2294" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="266.0" y="258" as="sourcePoint"/><mxPoint x="114.0" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p20-2295" value="je Mandant&lt;br&gt;in den Bucket" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=center;verticalAlign=middle;fontSize=10;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="120.0" y="224" width="140" height="32" as="geometry"/></mxCell><mxCell id="p20-2296" value="Stammdaten im Bucket&lt;br&gt;(IBAN-Abgleich, Kontierung)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="39.0" y="276" width="150" height="56" as="geometry"/></mxCell><mxCell id="p20-2297" value="DATEVconnect&lt;br&gt;(Beraternr-Mandantennr)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#F2F4F5;strokeColor=#5F6B73;fontColor=#1B1B1B;fontSize=10;" vertex="1" parent="1"><mxGeometry x="495.0" y="276" width="150" height="40" as="geometry"/></mxCell><mxCell id="p20-2298" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=3;fillColor=none;strokeColor=#5F6B73;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#5F6B73;" vertex="1" parent="1"><mxGeometry x="30" y="362" width="1074" height="236" as="geometry"/></mxCell><mxCell id="p20-2299" value="② je Rechnung, ereignisgesteuert · S-01 Buchungsvorschlag + Beleglink (Status K)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=le