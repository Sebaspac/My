t="40" as="geometry"/></mxCell><mxCell id="p22-2740" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#FFF5CC;strokeColor=#E8912D;fontColor=#1B1B1B;fontSize=11;fillColor=#E8912D;strokeColor=#E8912D;" vertex="1" parent="1"><mxGeometry x="1422.0" y="809" width="16" height="16" as="geometry"/></mxCell><mxCell id="p22-2741" value="QG-3 Bau/BIM4You&lt;br&gt;produktiv&lt;br&gt;(Ende M10)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1388.0" y="824" width="84" height="40" as="geometry"/></mxCell><mxCell id="p22-2742" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rhombus;fillColor=#FFF5CC;strokeColor=#E8912D;fontColor=#1B1B1B;fontSize=11;fillColor=#E8912D;strokeColor=#E8912D;" vertex="1" parent="1"><mxGeometry x="1513.0" y="809" width="16" height="16" as="geometry"/></mxCell><mxCell id="p22-2743" value="QG-4 Verträge&lt;br&gt;+ Post&lt;br&gt;(Ende M11)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1479.0" y="824" width="84" height="40" as="geometry"/></mxCell><mxCell id="p22-2744" value="&lt;b&gt;Leitgedanken&lt;/b&gt;&lt;br&gt;• Rechnungseingang zuerst, dann PM-Freigabe, Bau/BIM4You, Verträge, Post (P8).&lt;br&gt;• BeSync in Phase 1 nur für die Protokollierung (S-12); Lieferanten-App-Automatik (S-04/S-05), S-11 und Exportskript S-15 in Phase 2.&lt;br&gt;• Phasen 3 und 4 können sich überschneiden (gemeinsame MDIS-Ressourcen)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="876" width="560" height="150" as="geometry"/></mxCell><mxCell id="p22-2745" value="&lt;b&gt;Kritischer Pfad und Abhängigkeiten&lt;/b&gt;&lt;br&gt;• DATEV-Anbindung in Woche 1 von Phase 0 anstoßen (Hoster, Trios, Gateway, OP-04).&lt;br&gt;• Mandantenerkennung mit echten Belegen (OP-02) und Test T03 vor Pilot-Go-live.&lt;br&gt;• Phase 3: ED-03, OP-06 (BIB GmbH), OP-07, OPOS-Zugriff (OP-04/OP-43). Projektstart Q4/2026 → Pilot-Go-live Q1/2027." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="876" width="560" height="150" as="geometry"/></mxCell><mxCell id="p22-2746" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="1200" y="876" width="414" height="150" as="geometry"/></mxCell><mxCell id="p22-2747" value="Legende Balken" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="880" width="394" height="20" as="geometry"/></mxCell><mxCell id="p22-2748" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#1F6F78;strokeColor=#1F6F78;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1212" y="906" width="30" height="16" as="geometry"/></mxCell><mxCell id="p22-2749" value="Phase / d.velop Standard" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1250" y="904" width="354" height="20" as="geometry"/></mxCell><mxCell id="p22-2750" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="1212" y="930" widt