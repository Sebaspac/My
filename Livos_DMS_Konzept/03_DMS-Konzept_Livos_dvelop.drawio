16" width="24" height="16" as="geometry"/></mxCell><mxCell id="p17-1864" value="offen / zu verifizieren [O]" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="757" y="814" width="159" height="20" as="geometry"/></mxCell><mxCell id="p17-1865" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="928" y="824" as="sourcePoint"/><mxPoint x="962" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p17-1866" value="Sequenz" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="966" y="814" width="47" height="20" as="geometry"/></mxCell><mxCell id="p17-1867" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1025" y="824" as="sourcePoint"/><mxPoint x="1059" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p17-1868" value="Datenfluss" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1063" y="814" width="64" height="20" as="geometry"/></mxCell><mxCell id="p17-1869" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;startArrow=oval;startFill=0;dashed=1;strokeColor=#5F6B73;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1139" y="824" as="sourcePoint"/><mxPoint x="1173" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p17-1870" value="Nachricht / E-Mail" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1177" y="814" width="108" height="20" as="geometry"/></mxCell><mxCell id="p17-1871" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1297" y="824" as="sourcePoint"/><mxPoint x="1331" y="824" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p17-1872" value="Ablehnen / Zurückweisen" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="814" width="136" height="20" as="geometry"/></mxCell><mxCell id="p17-1873" value="&lt;b&gt;KI nur in C1 (AE-01/AE-02)&lt;/b&gt;&lt;br&gt;KI-Trennung und -Klassifizierung setzen Betriebsform C1 und Edition business voraus. Unter 80 % Sicherheit wird „Unbestimmt“ gesetzt; die drei wahrscheinlichsten Kategorien stehen zur Auswahl. In C2 nur Regel/Barcode." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40.0" y="846" width="383.0" height="150" as="geometry"/></mxCell><mxCell id="p17-1874" value="&lt;b&gt;mail dispatcher&lt;/b&gt;&lt;br&gt;Erstempfänger immer eine Gruppe (sonst keine Aufgabe); erste Person übernimmt. Weiterleitung protokolliert. Erinnerung nach 3 AT (Vorschlag), Eskalation über Priorität. Cloud-Lizenz klären (OP-13). Alternative: VLOTT Postverteilung." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="437.0" y="846" width="383.0" height="150" as="geometry"/></mxCell><mxCell id="p17-1875" value="&lt;b&gt;Scan intern oder Dienstleister (OP-13)&lt;/b&gt;&lt;br&gt;Empfehlung: Start intern in der Poststelle (am Eingangstag, Qualitätskontrolle im Stapel). Dienstleister nur bei Engpass; Einlieferung per Postfach oder Inbound-API – SFTP nicht belegt." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="834.0" y="846" width="383.0" height="150" as="geometry"/></mxCell><mxCell id="p17-1876" value="&lt;b&gt;Ablage (P1, AE-19)&lt;/b&gt;&lt;br&gt;Mandant E-01 ist schon am Postdokument Pflicht (Trennblatt-Barcode, Alias oder manuell). Mit „Es ist für mich“ wählt der Empfänger Zielkategorie und Akte; Kreditor/Objekt nach Bedarf der Kategorie." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1231.0" y="846" width="383.0" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p18" name="18 Rollen und Berechtigungsmatrix"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p18-1877" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=0;fillColor=#1F6F78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1654" height="8" as="geometry"/></mxCell><mxCell id="p18-1878" value="18 Rollen und Berechtigungsmatrix" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=24;fontStyle=1;fontColor=#17324D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1274" height="40" as="geometry"/></mxCell><mxCell id="p18-1879" value="Berechtigungsmatrix Rolle × Kategorie × Recht gemäß Kapitel 13.4: Rollen R-01 … R-15 × Kategorien K-01 … K-15 – Besetzung und Mengen legt Livos in Phase 0 fest (OP-17, OP-03)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=13;fontColor=#5F6B73;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1274" height="40" as="geometry"/></mxCell><UserObject id="p18-1880" label="◀ zur Übersicht (Seite 00)" link="data:page/id,p00"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1F6F78;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1334" y="28" width="280" height="30" as="geometry"/></mxCell></UserObject><mxCell id="p18-1881" value="Livos · DMS-Gesamtkonzept d.velop · 18 Rollen und Berechtigungsmatrix · MDIS Consulting · Stand 26.09.2026 · Entwurf zur Abstimmung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="1135" width="1574" height="22" as="geometry"/></mxCell><mxCell id="p18-1882" value="VORSCHLAG – zur Abstimmung" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=50;fillColor=#E8912D;strokeColor=none;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1250" y="70" width="220" height="26" as="geometry"/></mxCell><mxCell id="p18-1883" value="ID" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#17324D;strokeColor=#D9DEE2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="44" height="58" as="geometry"/></mxCell><mxCell id="p18-