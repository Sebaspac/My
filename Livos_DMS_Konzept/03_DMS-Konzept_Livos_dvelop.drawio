lor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="830" y="957" width="90" height="18" as="geometry"/></mxCell><mxCell id="p02-275" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;dashed=1;strokeColor=#1F6F78;fontSize=10;fontColor=#1F6F78;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p02-247" target="p02-241"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="423" y="1095"/><mxPoint x="110" y="1095"/></Array></mxGeometry></mxCell><mxCell id="p02-276" value="S-11" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;spacing=0;spacingLeft=2;spacingRight=2;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="116" y="1060" width="40" height="18" as="geometry"/></mxCell><mxCell id="p02-277" value="&lt;b&gt;Rückkanäle BIM4You / DATEV → DMS-Eigenschaften&lt;/b&gt;&lt;br&gt;&lt;b&gt;Kein Schreibzugriff auf laufende smart-invoice-Belege&lt;/b&gt;&lt;br&gt;&lt;br&gt;S-06 (Zahlstatus aus DATEV-OPOS, Phase 3) und S-09 (Prüfergebnis BIM4You) setzen über BeSync DMS-Eigenschaften am Beleg (E-22, E-23) und legen Prüfberichte ab (K-08). Laufende smart-invoice-Belege ändert BeSync nicht per API (nicht belegt, OP-07). Den Zahlbetrag setzt die Rechnungsprüfung auf Basis des BIM4You-Ergebnisses." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#F8DAD6;strokeColor=#C0392B;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="790" width="484" height="150" as="geometry"/></mxCell><mxCell id="p02-278" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#D9DEE2;" vertex="1" parent="1"><mxGeometry x="1130" y="960" width="300" height="102" as="geometry"/></