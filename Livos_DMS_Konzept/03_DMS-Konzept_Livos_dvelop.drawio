" vertex="1" parent="1"><mxGeometry x="750" y="620" width="120" height="70" as="geometry"/></mxCell><mxCell id="p05-570" value="&lt;b&gt;K-05 Vertrag&lt;/b&gt;&lt;br&gt;+ Nachträge" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=document;boundedLbl=1;size=0.15;fillColor=#FFFFFF;strokeColor=#5F6B73;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="620" width="120" height="70" as="geometry"/></mxCell><mxCell id="p05-571" value="S8" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=block;endFill=1;strokeColor=#5F6B73;rounded=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="p05-561" target="p05-568"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05-572" value="S8" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=block;endFill=1;strokeColor=#5F6B73;rounded=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="p05-561" target="p05-569"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05-573" value="S5" style="edgeStyle=elbowEdgeStyle;elbow=vertical;html=1;endArrow=block;endFill=1;strokeColor=#5F6B73;rounded=0;labelBackgroundColor=#FFFFFF;fontSize=11;fontStyle=1;" edge="1" parent="1" source="p05-562" target="p05-570"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05-574" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#5F6B73;fontSize=10;strokeColor=#E8912D;strokeWidth=2;dashed=1;startArrow=open;endArrow=open;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p05-559" target="p05-560"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05-575" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#5F6B73;fontSize=10;strokeColor=#E8912D;strokeWidth=2;dashed=1;startArrow=open;endArrow=open;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p05-560" target="p05-568"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="655"/></Array></mxGeometry></mxCell><mxCell id="p05-576" value="&lt;b&gt;Mehrfachablage:&lt;/b&gt; ein Original RE-2026-1041 (Musterbau GmbH, 14.756,00 €), drei Fundorte – keine Kopie:&lt;br&gt;• Kreditorenakte Musterbau GmbH (S3)&lt;br&gt;• Objektakte BV Hafenstraße 22 (S4)&lt;br&gt;• Vorgangsakte A-2026-0815 (S8, nur wenn E-19 gefüllt)&lt;br&gt;&lt;br&gt;Beispielwerte fiktiv (Demo-Testdaten)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=11;fillColor=#FFF5CC;strokeColor=#E8912D;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="160" y="520" width="420" height="170" as="geometry"/></mxCell><mxCell id="p05-577" value="Grundsätze" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="128" width="574" height="26" as="geometry"/></mxCell><mxCell id="p05-578" value="• &lt;b&gt;Mandant in jeder Erkennungskombination&lt;/b&gt; – Kreditor- und Objektnummern kollidieren je Gesellschaft.&lt;br&gt;• &lt;b&gt;Maximal 4 Ebenen&lt;/b&gt; (Workshop-Empfehlung 4–5).&lt;br&gt;• &lt;b&gt;Erkennungsfelder sind Pflicht&lt;/b&gt; – leere Felder ergeben keine Aktenverknüpfung (Verhalten in der Cloud testen, OP-08).&lt;br&gt;• &lt;b&gt;Akten sind eigene Kategorien&lt;/b&gt; mit eigenen Permissions nach demselben Muster (RS_Mandant).&lt;br&gt;• &lt;b&gt;Mehrfachablage&lt;/b&gt; über eine zweite Regel für dasselbe Dokument (Test T13).&lt;br&gt;• smart-invoice-„Kreditorenvorgangsakte“ wiederverwenden oder bewusst ersetzen.&lt;br&gt;• Livos liefert die fachliche Ordnerstruktur (OP-17)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="574" height="180" as="geometry"/></mxCell><mxCell id="p05-579" value="Gesellschaftsübergreifende Lieferantensicht" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="360" width="574" height="26" as="geometry"/></mxCell><mxCell id="p05-580" value="&lt;b&gt;Gespeicherte Suche „Lieferant L-000123“&lt;/b&gt;&lt;br&gt;E-07 Konsolidierungsnummer = L-000123" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=8;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#17324D;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="392" width="280" height="110" as="geometry"/></mxCell><mxCell id="p05-581" value="Alle Dokumente der Musterbau GmbH in allen Gesellschaften, für die der Benutzer berechtigt ist&lt;br&gt;(keine eigene Akte)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F6F78;fontColor=#1B1B1B;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="392" width="264" height="110" as="geometry"/></mxCell><mxCell id="p05-582" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#17324D;fontSize=10;" edge="1" parent="1" source="p05-580" target="p05-581"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p05-583" value="Gespeicherte Suchen und Akten respektieren die Rechte (RS_Mandant) – Nutzer sehen nur ihre Gesellschaften." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=10;fontColor=#5F6B73;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1040" y="506" width="574" height="30" as="geometry"/></mxCell><mxCell id="p05-584" value="Beispiel Bau-Rechnung (Vorgangsakte)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="548" width="574" height="26" as="geometry"/></mxCell><mxCell id="p05-585" value="Die Rechnung RE-2026-1041 trägt die Auftragsnummer A-2026-0815 (E-19). Regel S8 verknüpft sie zusätzlich mit der Vorgangsakte „A-2026-0815 · Rohbau Los 3“ – zusammen mit Auftragsbestätigung und Aufmaß. So entsteht die Sicht Auftrag → Abschläge → Schlussrechnung für die VOB-Kumulation (Prüfung in BIM4You, WF-02)." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=12;fillColor=#D6ECEE;strokeColor=#1F6F78;fontColor=#1B1B1B;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="580" width="574" height="110" as="geometry"/></mxCell><mxCell id="p05-586" value="Aktenbildungsregeln S1 – S10 (Strukturregeln; S1–S6 Kern, S7–S10 Ergänzung – nicht zu verwechseln mit Schnittstellen S-xx)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=15;fontStyle=1;fontColor=#1F6F78;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="1574" height="26" as="geometry"/></mxCell><mxCell id="p05-587" value="Regel" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#17324D;strokeColor=#D9DEE2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=left;spacingLeft=4;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="742" width="70" height="28" as="geometry"/></mxCell><mxCell id="p05-588" value="Übergeordnet → untergeordnet" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;fillColor=#17324D;strokeColor=#D9DEE2;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=left;spacingLeft=4;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="110"