ertex="1" parent="1"><mxGeometry x="1063" y="962" width="64" height="20" as="geometry"/></mxCell><mxCell id="p09-1039" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endFill=0;startArrow=oval;startFill=0;dashed=1;strokeColor=#5F6B73;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1139" y="972" as="sourcePoint"/><mxPoint x="1173" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p09-1040" value="Nachricht / E-Mail" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1177" y="962" width="108" height="20" as="geometry"/></mxCell><mxCell id="p09-1041" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=10;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1297" y="972" as="sourcePoint"/><mxPoint x="1331" y="972" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p09-1042" value="Ablehnen / Zurückweisen" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=12;align=left;verticalAlign=top;spacing=4;fontSize=10;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1335" y="962" width="136" height="20" as="geometry"/></mxCell><mxCell id="p09-1043" value="&lt;b&gt;Clearing je Mandant [K]&lt;/b&gt;&lt;br&gt;Globale Clearing-Gruppe SI_Clearing_Zentral (Kreditorenbuchhaltung Livos); SI_Clearing_&amp;lt;MandantNr&amp;gt; nur dort, wo eine eigene Buchhaltungsverantwortung besteht. WF-04 ist ein fachlich eigener Prozess (AE-04), technisch Klärfall-Schritt und Clearing in WF-01 bis WF-03; eine eigene Definition bleibt möglich." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=1;arcSize=6;fillColor=#DCEAF7;strokeColor=#2E75B6;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="994" width="780" height="76" as="geometry"/></mxCell><mxCell id="p09-1044" value="&lt;b&gt;Jede Automatik hat einen Klärfall-Ausgang (P7)&lt;/b&gt;&lt;br&gt;Hinweise (Dublette, Zahlungsbedingung, IBAN, § 13b-Plausibilität) quittiert R-02 in der Verteilung. Rückweisungen an den Lieferanten laufen über WF-05 (Seite 13); IBAN-Abweichung und § 48b sind Sonderfälle mit eigener Behandlung." style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;shape=note;size=14;fillColor=#FFF5CC;strokeColor=#E8912D;align=left;verticalAlign=top;spacing=6;fontSize=11;fontSize=10;" vertex="1" parent="1"><mxGeometry x="834" y="994" width="780" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10" name="10 Bau-Rechnung mit BIM4You (WF-02)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p10-1045" value="" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;rounded=0;fillColor=#1F6F78;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1654" height="8" as="geometry"/></mxCell><mxCell id="p10-1046" value="10 · Bau-Eingangsrechnung mit BIM4You (WF-02)" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=24;fontStyle=1;fontColor=#17324D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1274" height="40" as="geometry"/></mxCell><mxCell id="p10-1047" value="Asynchroner Transfer an BIM4You nach der Sachlichen Prüfung · S-08 Hinweg, S-09 Rückweg · AE-11 · Nur d.velop übergibt Eingangsrechnungen an DATEV" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;text;fontSize=13;fontColor=#5F6B73;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1274" height="40" as="geo